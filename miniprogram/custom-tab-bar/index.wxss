/* 底部导航：白色浮岛胶囊（品牌绿 #0C5F03 不变） */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 28rpx calc(18rpx + env(safe-area-inset-bottom)) 28rpx;
  background: transparent;
  z-index: 100;
  box-sizing: border-box;
}

.tab-bar.hidden {
  opacity: 0;
  pointer-events: none;
}

.tab-bar-border {
  display: none;
}

.tab-bar-inner {
  display: flex;
  align-items: center;
  height: 112rpx;
  background-color: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(12, 95, 3, 0.10);
  border-radius: 999rpx;
  box-shadow: 0 12rpx 36rpx rgba(12, 95, 3, 0.16);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  overflow: hidden;
}

.tab-bar-item {
  flex: 1;
  height: 112rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  position: relative;
}

.tab-bar-img {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.38;
}

.tab-bar-item.active .tab-bar-img {
  opacity: 1;
  filter: sepia(1) saturate(6) hue-rotate(85deg) brightness(0.85);
}

.tab-bar-title {
  font-size: 19rpx;
  margin-top: 6rpx;
  letter-spacing: 0.5rpx;
  color: rgba(16, 22, 15, 0.42);
}

.tab-bar-item.active .tab-bar-title {
  color: #0C5F03;
  font-weight: 700;
}

/* =========================================================
   v5.4 主题色强化：选中项整块浅绿胶囊底 + 亮绿文字
   （品牌色 #0C5F03 不变，大面积填充改用亮绿 --dk-accent-2 #14801F）
   ========================================================= */

.tab-bar-item.active::before {
  content: '';
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 10rpx;
  bottom: 10rpx;
  border-radius: 999rpx;
  background-color: rgba(20, 128, 31, 0.12);
}
.tab-bar-item.active .tab-bar-img { position: relative; z-index: 1; }
.tab-bar-item.active .tab-bar-title { position: relative; z-index: 1; color: #14801F; font-weight: 700; }

/* =========================================================
   审核态：整条 tabBar 完全撤掉（不留占位、不吃点击）
   .hidden 是 opacity:0 但还占着 fixed 层，审核态要更彻底，
   否则底部仍能点到「透明按钮」跳去别的 tab。
   ========================================================= */

.tab-bar.review-hidden {
  display: none;
}
