.tab-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(14rpx + env(safe-area-inset-bottom));
  height: 104rpx;
  background: rgba(255, 255, 255, 0.97);
  border-radius: 999rpx;
  box-shadow: 0 10rpx 30rpx rgba(12, 95, 3, 0.16);
  display: flex;
  align-items: center;
  padding: 0 10rpx;
  box-sizing: border-box;
  z-index: 100;
}

.tab-bar.hidden {
  opacity: 0;
}

.tab-bar-border {
  display: none;
}

.tab-bar-item {
  flex: 1;
  height: 84rpx;
  margin: 0 4rpx;
  border-radius: 999rpx;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  transition: background-color 0.18s ease;
}

.tab-bar-item.active {
  background-color: var(--color-primary-soft);
}

.tab-bar-img {
  width: 44rpx;
  height: 44rpx;
}

.tab-bar-item.active .tab-bar-img {
  transform: scale(1.06);
}

.tab-bar-title {
  font-size: 19rpx;
  margin-top: 2rpx;
  letter-spacing: 1rpx;
}
