.tab-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  height: 116rpx;
  background-color: rgba(20, 26, 22, 0.88);
  backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.55);
  z-index: 100;
}

.tab-bar.hidden {
  opacity: 0;
}

.tab-bar-border {
  display: none;
}

.tab-bar-item {
  flex: 1;
  height: 96rpx;
  margin: 10rpx;
  border-radius: 999rpx;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  position: relative;
}

.tab-bar-item.active {
  background-color: rgba(74, 222, 128, 0.14);
}

.tab-bar-img {
  width: 44rpx;
  height: 44rpx;
  filter: brightness(0) invert(1);
  opacity: 0.5;
}

.tab-bar-item.active .tab-bar-img {
  filter: none;
  opacity: 1;
}

.tab-bar-title {
  font-size: 19rpx;
  margin-top: 5rpx;
  letter-spacing: 1rpx;
  color: rgba(237, 242, 237, 0.4);
}

.tab-bar-item.active .tab-bar-title {
  color: #4ADE80;
  font-weight: 600;
}
