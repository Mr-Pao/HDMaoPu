/* 底部导航：白色浮岛胶囊（品牌绿 #0C5F03 不变） */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 28rpx calc(18rpx + env(safe-area-inset-bottom)) 28rpx;
  background: transparent;
  z-index: 100;
  box-sizing: border-box;
}

.tab-bar.hidden {
  opacity: 0;
  pointer-events: none;
}

.tab-bar-border {
  display: none;
}

.tab-bar-inner {
  display: flex;
  align-items: center;
  height: 112rpx;
  background-color: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(12, 95, 3, 0.10);
  border-radius: 999rpx;
  box-shadow: 0 12rpx 36rpx rgba(12, 95, 3, 0.16);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  overflow: hidden;
}

.tab-bar-item {
  flex: 1;
  height: 112rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  position: relative;
}

.tab-bar-img {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.38;
}

.tab-bar-item.active .tab-bar-img {
  opacity: 1;
  filter: sepia(1) saturate(6) hue-rotate(85deg) brightness(0.85);
}

.tab-bar-title {
  font-size: 19rpx;
  margin-top: 6rpx;
  letter-spacing: 0.5rpx;
  color: rgba(16, 22, 15, 0.42);
}

.tab-bar-item.active .tab-bar-title {
  color: #0C5F03;
  font-weight: 700;
}
