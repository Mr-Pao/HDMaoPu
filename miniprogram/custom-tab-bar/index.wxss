.tab-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  height: 116rpx;
  background-color: rgba(255, 255, 255, 0.93);
  backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(12, 95, 3, 0.08);
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 10rpx 32rpx rgba(12, 95, 3, 0.12);
  z-index: 100;
}

.tab-bar.hidden {
  opacity: 0;
}

.tab-bar-border {
  display: none;
}

.tab-bar-item {
  flex: 1;
  height: 96rpx;
  margin: 10rpx;
  border-radius: 999rpx;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  position: relative;
}

.tab-bar-item.active {
  background-color: rgba(12, 95, 3, 0.07);
}

.tab-bar-img {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.42;
}

.tab-bar-item.active .tab-bar-img {
  opacity: 1;
}

.tab-bar-title {
  font-size: 19rpx;
  margin-top: 5rpx;
  letter-spacing: 1rpx;
  color: rgba(15, 26, 16, 0.4);
}

.tab-bar-item.active .tab-bar-title {
  color: #0C5F03;
  font-weight: 700;
}
