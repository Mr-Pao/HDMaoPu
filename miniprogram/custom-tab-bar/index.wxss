.tab-bar {
  position: fixed;
  left: 22rpx;
  right: 22rpx;
  bottom: calc(14rpx + env(safe-area-inset-bottom));
  height: 112rpx;
  background-color: rgba(14, 18, 17, 0.86);
  backdrop-filter: blur(28rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 14rpx 44rpx rgba(0, 0, 0, 0.6);
  z-index: 100;
}

.tab-bar.hidden {
  opacity: 0;
}

.tab-bar-border {
  display: none;
}

.tab-bar-item {
  flex: 1;
  height: 88rpx;
  margin: 12rpx;
  border-radius: 24rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  position: relative;
}

.tab-bar-item.active {
  background-color: rgba(255, 255, 255, 0.09);
}

.tab-bar-img {
  width: 42rpx;
  height: 42rpx;
  filter: brightness(0) invert(1);
  opacity: 0.42;
}

.tab-bar-item.active .tab-bar-img {
  filter: none;
  opacity: 1;
}

.tab-bar-title {
  font-size: 19rpx;
  margin-top: 5rpx;
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.36);
}

.tab-bar-item.active .tab-bar-title {
  color: #FFFFFF;
  font-weight: 600;
}
