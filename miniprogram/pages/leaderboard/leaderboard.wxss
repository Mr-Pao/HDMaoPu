@import "/pages/public/wxss/hFilter.wxss";

page {
  height: 100%;
  background: var(--color-gray-light);
}

.thread-list {
  display: flex;
  justify-content: space-around;
  padding: 10rpx 100rpx 0 100rpx;
  overflow: hidden;
  background-color: var(--color-surface);
  box-sizing: border-box;
  box-shadow: 0rpx 0rpx 10rpx var(--color-gray);
}

.thread-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
}

.thread-item-name {
  font-size: 28rpx;
  color: var(--color-gray-max);
}

.thread-item-bar {
  width: 100rpx;
  height: 4rpx;
  border-radius: 10rpx;
}

.thread-item.active .thread-item-bar {
  background-color: var(--color-primary);
}

.thread-item.active .thread-item-name {
  color: var(--color-black-light);
}

/* 左右滑动的频道内容 */
#main-swiper {
  /* TODO: 偷懒了，不一定充满屏幕 */
  min-height: 80%;
}

.main {
  display: flex;
  align-items: flex-start;
  padding: 0 8rpx;
}

.column {
  width: 50%;
}

.column_item {
  width: 350rpx;
  background: var(--color-surface);
  margin: 0rpx auto 20rpx auto;
  border-radius: 10rpx;
  overflow: hidden;
}

.column_pic {
  position: relative;
  /* width: 100%; */
  overflow: hidden;
}
.column_pic image{
  width: 100%;
  margin: 0;
  padding: 0;
  vertical-align: bottom;
}
.location{
  position: absolute;
  top: 18rpx;
  right: 15rpx;
  color: var(--color-gray);
  text-align:end;
  font-size: 18rpx;
  background-color:var(--color-black-transparent);
  padding:5rpx 10rpx;
  border-radius: 10rpx;
}

.info {
  width: 350rpx;
  display: flex;
  padding: 18rpx 0rpx 18rpx 24rpx;
  align-items: center;
  box-sizing: border-box;
  justify-content: space-between;
}

.names {
  display: inline-block;
  width: 300rpx;
  max-width: 300rpx;
  box-sizing: border-box;
}

.cat-name {
  font-size: 28rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  color: var(--color-black-min);
}
.cat-name .campus {
  font-size: 18rpx;
  color: var(--color-gray-dark);
  font-weight: lighter;
}

.photo-info{
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
}
.pher-name{
  font-size: 22rpx;
  color: var(--color-gray-max);
  margin-right: 16rpx;
}
.photo-date {
  font-size: 22rpx;
  color: var(--color-gray-max);
  flex-shrink: 0;
}


.like-button {
  /* width: 100rpx; */
  display: inline-flex;
  flex-direction: column;
  align-items: center;
}

heart {
  margin: -20rpx 0 -25rpx 0;
}

.like-num {
  width: 100rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--color-gray-max);
}

.hide {
  display: none;
}


.loading image {
  width: 165.9rpx;
  height: 90.3rpx;
  margin: 10rpx 292rpx;

}
.loadnomore image {
  width: 750rpx;
  height: 100rpx;
  margin: 10rpx 0;
}

.ellipsis-text {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.h-filter-list {
  display: flex;
  justify-content: center;
}
.h-filter-item.long {
  margin: 20rpx 20rpx 20rpx 20rpx;
}

/* ================= v4.2 榜单重构 ================= */
page {
  background: var(--color-bg);
}
.thread-list {
  padding: 8rpx 40rpx 0 40rpx;
  background-color: transparent;
  box-shadow: none;
  align-items: flex-start;
}
.thread-item {
  padding: 6rpx 32rpx;
  border-radius: var(--radius-pill);
  margin: 0 6rpx;
  transition: background-color 0.2s ease;
}
.thread-item.active {
  background-color: var(--color-primary-soft);
}
.thread-item-bar {
  display: none;
}
.thread-item-name {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}
.thread-item.active .thread-item-name {
  color: var(--color-primary);
  font-weight: 600;
}
.column_item {
  width: 342rpx;
  border-radius: 24rpx;
  margin: 0 auto 18rpx auto;
  box-shadow: 0 4rpx 16rpx rgba(12, 95, 3, 0.07);
}
.location {
  top: 16rpx;
  right: 16rpx;
  font-size: 19rpx;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-pill);
  background-color: rgba(31, 36, 33, 0.55);
  color: var(--color-surface);
}
.info {
  width: 342rpx;
  padding: 16rpx 4rpx 16rpx 18rpx;
}
.names {
  width: 290rpx;
  max-width: 290rpx;
}
.cat-name {
  font-size: 29rpx;
  letter-spacing: 1rpx;
  color: var(--color-text);
}
.pher-name, .photo-date {
  font-size: 21rpx;
  color: var(--color-text-tertiary);
}
.like-num {
  font-size: 19rpx;
  color: var(--color-text-tertiary);
}
.h-filter-list {
  justify-content: flex-start;
  padding: 0 22rpx;
}


/* ================= v4.3.0 榜单：杂志排版风 ================= */
page {
  background: #F2F0E9;
}
.thread-list {
  padding: 10rpx 24rpx 0 24rpx;
  background-color: transparent;
  box-shadow: none;
  align-items: center;
  justify-content: flex-start;
}
.thread-item {
  padding: 8rpx 26rpx;
  border-radius: 2rpx;
  margin: 0 10rpx 0 0;
  border: 2rpx solid transparent;
}
.thread-item.active {
  background-color: #0C5F03;
  border-color: #0C5F03;
}
.thread-item-bar {
  display: none;
}
.thread-item-name {
  font-size: 27rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #5A5648;
}
.thread-item.active .thread-item-name {
  color: #FBFAF6;
  font-weight: 800;
}
.column_item {
  width: 342rpx;
  border-radius: 2rpx;
  margin: 0 auto 18rpx auto;
  background-color: #FBFAF6;
  border: 2rpx solid #0C5F03;
  box-shadow: 6rpx 6rpx 0 #0C5F03;
}
.location {
  top: 12rpx;
  right: 12rpx;
  font-size: 19rpx;
  letter-spacing: 1rpx;
  padding: 0 12rpx;
  height: 38rpx;
  line-height: 38rpx;
  border-radius: 2rpx;
  background-color: #0C5F03;
  color: #FBFAF6;
}
.info {
  width: 342rpx;
  padding: 16rpx 4rpx 16rpx 16rpx;
}
.cat-name {
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 0;
  color: #12200C;
}
.pher-name, .photo-date {
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: #8A8578;
}
.like-num {
  font-size: 19rpx;
  color: #8A8578;
}


/* ================= v4.4 榜单：深色沉浸 ================= */
page {
  background-color: #080B09;
  color: #EDF2ED;
}
.thread-list {
  background-color: transparent;
  box-shadow: none;
  padding: 12rpx 26rpx 4rpx 26rpx;
}
.thread-item {
  padding: 10rpx 28rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background-color: rgba(255, 255, 255, 0.055);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}
.thread-item.active {
  background-color: #4ADE80;
  border-color: #4ADE80;
}
.thread-item-bar {
  display: none;
}
.thread-item-name {
  color: rgba(237, 242, 237, 0.55);
  font-size: 25rpx;
  font-weight: 600;
}
.thread-item.active .thread-item-name {
  color: #080B09;
  font-weight: 700;
}
.column_item {
  background-color: rgba(255, 255, 255, 0.045);
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 28rpx;
  box-shadow: none;
}
.location {
  background-color: rgba(0, 0, 0, 0.45);
  border-radius: 999rpx;
  color: #FFFFFF;
  backdrop-filter: blur(8rpx);
}
.cat-name {
  color: #EDF2ED;
  font-weight: 700;
}
.pher-name, .photo-date, .like-num {
  color: rgba(237, 242, 237, 0.36);
}
