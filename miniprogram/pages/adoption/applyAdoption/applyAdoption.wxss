.page {
  padding: 30rpx;
  min-height: 100vh;
  background: var(--color-bg);
  box-sizing: border-box;
}

.cat-card {
  display: flex;
  align-items: center;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.cat-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--color-border);
}

.cat-info {
  margin-left: 24rpx;
}

.cat-name {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--color-text);
}

.cat-desc {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  margin-top: 8rpx;
}

/* 历史申请状态卡片 */
.status-card {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.status-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
}

.status-badge {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-pill);
}

.status-pending { background: var(--color-warning-soft); color: var(--color-warning); }
.status-reviewing { background: var(--color-info-soft); color: var(--color-info); }
.status-approved { background: var(--color-success-soft); color: var(--color-success); }
.status-rejected { background: var(--color-danger-soft); color: var(--color-danger); }
.status-cancelled { background: var(--color-bg); color: var(--color-text-tertiary); }

.status-line {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  line-height: 1.8;
}

.status-note {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg);
  border-radius: var(--radius-md);
  padding: 16rpx 20rpx;
  margin-top: 12rpx;
  line-height: 1.6;
}

.status-tip {
  font-size: 24rpx;
  color: var(--color-warning);
  margin-top: 16rpx;
  line-height: 1.6;
}

.form-block {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 10rpx 24rpx;
}

.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: var(--color-text);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.required {
  color: var(--color-danger);
}

.input {
  background: var(--color-bg);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.textarea {
  background: var(--color-bg);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
  height: 220rpx;
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: var(--color-text-placeholder);
  margin-top: 8rpx;
}

.tip {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  line-height: 1.6;
  margin: 24rpx 8rpx;
}

.submit-btn {
  background: var(--color-primary);
  color: var(--color-text-onPrimary);
  border-radius: var(--radius-pill);
  font-size: 32rpx;
  margin-top: 20rpx;
}

.submit-btn.disabled {
  background: var(--color-gray-dark);
}
