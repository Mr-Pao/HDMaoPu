/* miniprogram/pages/science/sciDetail/sciDetail.wxss */

swiper {
  width: 692rpx;
  height: 261rpx;
  margin: 20rpx 29rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

swiper image {
  width: 692rpx;
  height: 261rpx;
  border-radius: 20rpx;
}

/* 下面是qna环节 */
.qna {
  width: 692rpx;
  margin: 30rpx 29rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  /* background-color: rgb(229,229,229); */
  border: 3rpx solid var(--color-primary);
  padding: 30rpx;
  box-sizing: border-box;
}

.qna .question {
  text-align: center;
}

.qna .answer {
  height: 0;
  font-size: 26rpx;
  line-height: 40rpx;
  overflow: hidden;
}

.qna.active {
  border: 5rpx solid var(--color-primary);
}

.qna.active .question {
  font-weight: bold;
}

.qna.active .answer {
  height: auto;
  margin-top: 20rpx;
}

/* =========================================================
   v5.1 全站统一外观（二级页自动套用）
   与首页/图库/详情页同一套：白底、细描边、大圆角、无重阴影
   ========================================================= */
page {
  background-color: var(--dk-bg);
  color: var(--dk-text);
}

/* 卡片圆角统一到 20rpx 档 */
.card, .box, .item-card, .list-item, .cell {
  border-radius: 20rpx;
}
