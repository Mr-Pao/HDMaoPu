/* pages/news/news.wxss */
page {
  height: 100%;
  background-color: var(--color-gray-light);
}

.news-box {
  box-sizing: border-box;
  padding: 25rpx 25rpx 25rpx 30rpx;
  margin: 30rpx;
  box-shadow: 5rpx 5rpx 30rpx var(--color-gray-normal);
  border-radius: 20rpx;
  background-color: var(--color-surface);

  display: flex;
  justify-content: space-between;
  flex-grow: 1;
  overflow: hidden;
}

.news {
  font-weight: 300;
  /* margin: 10rpx 0; */
}

.news.infoBox{
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
  flex-grow: 1;
}

.news.title {
  font-size: 33rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.news .row-container{
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 8rpx;
}
.news.tag {
  width: 80rpx;
  height: 38rpx;
  border-radius: 15rpx;
  margin: 4rpx 12rpx 0 0;
  
  font-size: 24rpx;
  font-weight: 500;
  text-align: center;
  line-height: 38rpx;

  background-color: var(--color-primary-light);
  color: var(--color-primary);
}

.news.user {
  font-size: 26rpx;
  color: var(--color-gray-dark);
  margin-right: 10rpx;

  white-space: nowrap;  
  text-overflow:ellipsis; 
  overflow:hidden;
}
.news.time {
  font-size: 26rpx;
  color: var(--color-gray-dark);
  flex-grow: 1;
  text-align: right;
  white-space: nowrap;  
  text-overflow:ellipsis; 
  overflow: hidden;
}

.news.content-wrapper{

  flex-grow: 1;
}
.news.content {
  font-size: 28rpx;
  font-weight: 400;
  /* letter-spacing:0.005rpx; */

  margin-bottom: 10rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;

  color: var(--color-gray-max);

}

.loading image {
  width: 165.9rpx;
  height: 90.3rpx;
  margin: 10rpx 292rpx;
  margin-top: 40rpx;
}

.cover-image {
  width: 200rpx;
  height: 200rpx;

  border-radius: 10rpx;
  margin: 5rpx 5rpx 5rpx 30rpx;
  float: right;

  flex-shrink: 0;
  /* flex-grow: 1; */
}



.button_container {
  display: flex;
  flex-direction: row;
  margin: 20rpx 20rpx 0rpx 20rpx;
  justify-content: space-around;
  height: 130rpx;
}

/* 鎸夐挳鏈€変腑 */
.normal_button {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  width: 15%;
  border-bottom: 5rpx solid transparent;
  background-color: var(--color-surface);
  padding: 8rpx 5rpx;
  box-sizing: border-box;
  transition: background-color 500ms ease,
              border-color 500ms ease,
              color 500ms ease,
              font-weight 500ms ease;
}

/* 鎸夐挳閫変腑 */
.checked_button {
  border-color: var(--color-primary-dark);
  color: var(--color-primary-dark);
  font-weight: bold;
}

.tab-logo{
  width: 80rpx;
  height: 86rpx;
  padding: 8rpx 10rpx;
  transition: background-color 500ms ease,
              border-color 500ms ease,
              color 500ms ease,
              font-weight 500ms ease;
}
.checked_button .tab-logo {
background-color: var(--color-primary-light);
border-radius: 10rpx;
}

.tab-text{
  font-size: 24rpx;
  text-align: center;
}

.checked_button.tab-text{
  color: var(--color-surface);
  font-weight: 500;
}

swiper {
  width: 692rpx;
  height: 261rpx;
  margin: 25rpx 28rpx 23rpx 28rpx;
  border-radius: 15rpx;
  overflow: hidden;
}

swiper image {
  width: 692rpx;
  height: 261rpx;
  border-radius: 15rpx;
}

.emptyImg {
  width: 750rpx;
  height: 100rpx;
  margin: 30rpx 0;
}

/* ================= v5.0 猫抓板：白色主题 ================= */
page {
  background-color: var(--dk-bg);
  color: var(--dk-text);
}

/* 轮播 */
swiper {
  height: 300rpx;
  margin: 8rpx 24rpx 0 24rpx;
  border-radius: var(--dk-radius-lg);
  overflow: hidden;
  border: 1rpx solid var(--dk-line);
}
swiper image {
  width: 100%;
  height: 300rpx;
  border-radius: var(--dk-radius-lg);
}

/* 分类胶囊 */
.button_container {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 24rpx 4rpx 24rpx;
}
.normal_button,
.checked_button {
  height: 60rpx;
  padding: 0 28rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: var(--dk-radius-pill);
  font-size: 24rpx;
  line-height: 60rpx;
  letter-spacing: 0.5rpx;
  box-shadow: none;
}
.normal_button {
  color: var(--dk-text-2);
  background-color: transparent;
  border: 1rpx solid var(--dk-line);
}
.checked_button {
  color: #FFFFFF;
  background-color: var(--dk-accent);
  border: 1rpx solid var(--dk-accent);
  font-weight: 700;
}

/* 分类胶囊 v5.3 修复：横排不换行 */
.button_container {
  flex-wrap: nowrap;
  overflow-x: auto;
  white-space: nowrap;
}
.normal_button,
.checked_button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}
.tab-logo {
  height: 30rpx;
  width: 30rpx;
  margin-right: 6rpx;
}
.tab-text {
  white-space: nowrap;
  line-height: 1;
  font-size: 24rpx;
}

/* 列表卡 */
.news-box {
  margin: 0 24rpx 18rpx 24rpx;
  padding: 24rpx;
  background-color: var(--dk-card);
  border: 1rpx solid var(--dk-line);
  border-radius: var(--dk-radius);
  box-shadow: none;
}
.news.infoBox {
  flex: 1;
}
.news.title {
  color: var(--dk-text);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
  margin-bottom: 10rpx;
}
.news .content {
  color: var(--dk-text-2);
  font-size: 23rpx;
  line-height: 34rpx;
}
.news.tag {
  width: auto;
  height: 40rpx;
  padding: 0 16rpx;
  line-height: 40rpx;
  font-size: 20rpx;
  border-radius: var(--dk-radius-pill);
  background-color: var(--dk-accent-soft);
  color: var(--dk-accent-2);
}
.news .user,
.news .time {
  color: var(--dk-text-3);
  font-size: 20rpx;
}
.cover-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--radius-md);
  margin-left: 20rpx;
  flex: 0 0 180rpx;
}
.emptyImg {
  opacity: 0.5;
}

/* =========================================================
   v5.2 猫抓板精修
   ========================================================= */

.news-box {
  border-radius: 28rpx;
  border: 1rpx solid var(--dk-line);
  box-shadow: 0 2rpx 12rpx rgba(12, 95, 3, 0.045);
}
.news.title {
  font-size: 34rpx;
  letter-spacing: -0.5rpx;
}

/* 顶部大标题与猫谱页 .nav-t 对齐（52rpx） */
.nav-title {
  font-size: 52rpx;
  line-height: 56rpx;
  font-weight: 800;
  letter-spacing: -1.6rpx;
  margin-top: 10rpx;
}

/* =========================================================
   v4.0.78 分类胶囊精修：统一为等高胶囊，图标与文字同行居中，
   选中态实心绿、未选中态细描边，去掉图标底下的浅色方块
   ========================================================= */
.button_container {
  height: auto;
  margin: 16rpx 24rpx 4rpx 24rpx;
  padding: 2rpx 0;
  justify-content: flex-start;
  align-items: center;
  gap: 14rpx;
}
.normal_button,
.checked_button {
  flex: 0 0 auto;
  flex-direction: row;
  width: auto;
  height: 64rpx;
  padding: 0 26rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  border: 1rpx solid var(--dk-line);
  background-color: transparent;
  border-bottom-width: 1rpx;
  gap: 8rpx;
}
.normal_button .tab-text,
.checked_button .tab-text {
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1;
  color: var(--dk-text-2);
}
.checked_button {
  background-color: var(--dk-accent);
  border-color: var(--dk-accent);
}
.checked_button .tab-text {
  color: #FFFFFF;
  font-weight: 600;
}
.tab-logo,
.checked_button .tab-logo {
  height: 28rpx;
  width: 28rpx;
  padding: 0;
  margin: 0;
  border-radius: 0;
  background-color: transparent;
}
