/* pages/manage/manageNews/modifyNews/modifyNews.wxss */
page {
  width: 750rpx;
  padding: 30rpx 30rpx;
  box-sizing: border-box;
}

.label {
  font-size: 30rpx;
  font-weight: 600;
  margin: 25rpx 0 5rpx 0;
}

.label.light {
  font-weight: 400;
  margin: 5rpx 0;
}

input,
picker,
textarea {
  width: 670rpx;
  border-bottom: 2rpx var(--color-primary) solid;
  background-color: var(--color-white-dark);
  padding: 15rpx;
  color: var(--color-black-light);
}

button {
  width: 100%;
  font-size: 30rpx;
  margin-top: 10rpx;
  margin-bottom: 10rpx;
  border: 1rpx solid var(--color-gray-max);
  border-radius: 20rpx;
}

.submitButton, 
.authButton {
  width: 100%;
  font-size: 30rpx;
  margin-top: 10rpx;
  margin-bottom: 10rpx;
  background-color: var(--color-primary);
  border: 1rpx solid var(--color-gray-max);
  border-radius: 20rpx;
}

.userInfo {
  width: 100%;
  padding: 10rpx 0rpx 24rpx 0;
  display: flex;
  align-items: flex-start;
}

.userInfo image {
  height: 64rpx;
  width: 64rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background-color: var(--color-surface);
  flex-shrink: 0;
}

.userInfo .userInfo-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.userInfo .userInfo-name {
  font-size: 30rpx;
  line-height: 44rpx;
  color: var(--dk-text);
}

.userInfo .authHint {
  font-size: 22rpx;
  line-height: 30rpx;
  height: auto;
  color: var(--color-primary);
  opacity: 0.75;
}

.link-hover {
  opacity: 0.6;
}

.noAuth {
  width: 100%;
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 28rpx;
  color: var(--color-gray-dark);
}

.noAuth text {
  margin-bottom: 30rpx;
}

.lengthTips {
  font-size: 26rpx;
  color: var(--color-gray-max);
  float: right;
  margin-right: 10rpx;
  margin-top: 5rpx;
}

.album {
  width: 100%;
  text-align: center;
  background-color: var(--color-gray-light);
  color: var(--color-gray);
  font-size: 28rpx;
  padding: 5rpx 0;
}

.album-block {
  width: 750rpx;
  display: flex;
  flex-wrap: wrap;
  background-color: var(--color-gray-light);
}

.alb-image {
  width: 220rpx;
  height: 220rpx;
  box-sizing: border-box;
  margin: 5rpx 5rpx;
  background-color: var(--color-surface);
}

.button_container {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
}

/* 按钮未选中 */
.normal_button {
  margin: 10rpx;
  background-color: var(--color-surface);
}

/* 按钮选中 */
.checked_button {
  margin: 10rpx;
  background-color: var(--color-primary);
  color: var(--color-surface)
}

.line {
  background: #e0e3da;
  width: 100%;
  margin-top: 30rpx;
  margin-bottom: 20rpx;
  height: 2rpx;
}
/* =========================================================
   v5.1 全站统一外观（二级页自动套用）
   与首页/图库/详情页同一套：白底、细描边、大圆角、无重阴影
   ========================================================= */
page {
  background-color: var(--dk-bg);
  color: var(--dk-text);
}

/* 卡片圆角统一到 20rpx 档 */
.card, .box, .item-card, .list-item, .cell {
  border-radius: 20rpx;
}
