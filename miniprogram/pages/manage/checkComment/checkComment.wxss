/* pages/manage/checkComment/checkComment.wxss */
@import "../checkPhotos/checkPhotos.wxss";

.info {
  width: 100%;
}

.user-info {
  display: flex;
  flex-direction: row;
  align-items: center;
}


.user-avatar {
  width: 40rpx;
  height: 40rpx;
  margin: 0 10rpx 0 0;
}

.buttons {
  justify-content: flex-end;
}

/* =========================================================
   v5.1 全站统一外观（二级页自动套用）
   与首页/图库/详情页同一套：白底、细描边、大圆角、无重阴影
   ========================================================= */
page {
  background-color: var(--dk-bg);
  color: var(--dk-text);
}

/* 卡片圆角统一到 20rpx 档 */
.card, .box, .item-card, .list-item, .cell {
  border-radius: 20rpx;
}
