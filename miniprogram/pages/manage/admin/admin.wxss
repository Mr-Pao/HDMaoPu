/* pages/manage/admin/admin.wxss */

.container {
  padding: 30rpx;
  background-color: var(--color-gray-light);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ==================== 口令门 ==================== */
.gate {
  margin-top: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.gate-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.gate-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-primary, #0C5F03);
}

.gate-tip {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-gray-max);
}

.gate-input {
  margin-top: 50rpx;
  width: 520rpx;
  height: 88rpx;
  padding: 0 28rpx;
  background: var(--color-surface);
  border-radius: 20rpx;
  font-size: 30rpx;
  text-align: center;
  box-sizing: border-box;
}

.gate-btn {
  margin-top: 40rpx;
  width: 520rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: var(--color-primary, #0C5F03);
  color: var(--color-surface);
  font-size: 32rpx;
}

.gate-btn::after {
  border: none;
}

.gate-note {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: var(--color-gray-normal, #bbb);
  text-align: center;
  padding: 0 60rpx;
}

/* ==================== 头部 ==================== */
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.head-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-primary-text);
}

.head-lock {
  font-size: 26rpx;
  color: var(--color-gray-max);
  padding: 8rpx 20rpx;
  border: 1rpx solid var(--color-gray-normal);
  border-radius: 24rpx;
}

.head-tip {
  font-size: 24rpx;
  color: var(--color-gray-max);
  margin-bottom: 26rpx;
}

/* ==================== Tab 栏 ==================== */
.tabs {
  display: flex;
  background: var(--color-surface);
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-gray-max);
  border-radius: 20rpx;
}

.tab-active {
  background: var(--color-primary, #0C5F03);
  color: var(--color-surface);
  font-weight: 600;
}

/* ==================== 选择器 ==================== */
.picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--color-surface);
  border-radius: 20rpx;
  padding: 26rpx;
  font-size: 28rpx;
  color: var(--color-primary-text);
  margin-bottom: 22rpx;
}

.picker-value {
  color: var(--color-primary, #0C5F03);
  font-size: 28rpx;
}

/* ==================== 表单 ==================== */
.card {
  background: var(--color-surface);
  border-radius: 20rpx;
  padding: 10rpx 26rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.field {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-gray-light, #F2F2F2);
}

.field:last-of-type {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: var(--color-primary-text);
  width: 180rpx;
  flex-shrink: 0;
}

.input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: var(--color-primary-text);
}

.save-btn {
  margin: 30rpx 0;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  background: var(--color-primary, #0C5F03);
  color: var(--color-surface);
  font-size: 30rpx;
}

.save-btn::after {
  border: none;
}

.save-btn[disabled] {
  background: var(--color-primary-light, #8FBC94);
  color: var(--color-surface);
}

/* ==================== 照片审核 ==================== */
.photo-card {
  display: flex;
  align-items: center;
  background: var(--color-surface);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.photo-thumb {
  width: 200rpx;
  height: 150rpx;
  border-radius: 20rpx;
  background: var(--color-gray-light, #F2F2F2);
  flex-shrink: 0;
}

.photo-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
}

.photo-state {
  font-size: 24rpx;
  color: var(--color-primary, #0C5F03);
}

.photo-state.state-hidden {
  color: #D93025;
}

.photo-btn {
  padding: 10rpx 36rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
}

.btn-hide {
  color: var(--color-surface);
  background: #D93025;
}

.btn-restore {
  color: var(--color-surface);
  background: var(--color-primary, #0C5F03);
}

/* ==================== 友情链接 ==================== */
.link-tip {
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.link-row {
  display: flex;
  align-items: center;
  background: var(--color-surface);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.link-logo {
  width: 76rpx;
  height: 76rpx;
  border-radius: 38rpx;
  flex-shrink: 0;
  background: var(--color-gray-light, #F2F2F2);
}

.link-logo-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--color-gray-max);
}

.link-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.link-name {
  font-size: 28rpx;
  color: var(--color-primary-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.link-appid {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-gray-max);
}

.link-op {
  flex-shrink: 0;
  min-width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  margin-left: 8rpx;
  padding: 0 12rpx;
  border-radius: 26rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-gray-max);
  background: var(--color-gray-light, #F2F2F2);
  box-sizing: border-box;
}

.link-del {
  color: #D93025;
  padding: 0 20rpx;
}

.add-card {
  margin: 26rpx 0 0;
}

.add-title {
  font-size: 26rpx;
  color: var(--color-gray-max);
  padding: 24rpx 0 4rpx;
}

.add-btn {
  margin: 24rpx 0;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  background: var(--color-primary-soft, #E8F3EA);
  color: var(--color-primary, #0C5F03);
  font-size: 28rpx;
}

.add-btn::after {
  border: none;
}

/* ==================== 状态 ==================== */
.loading {
  text-align: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: var(--color-gray-max);
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  font-size: 28rpx;
  color: var(--color-gray-max);
}

/* =========================================================
   v5.1 全站统一外观（二级页自动套用）
   与首页/图库/详情页同一套：白底、细描边、大圆角、无重阴影
   ========================================================= */
page {
  background-color: var(--dk-bg);
  color: var(--dk-text);
}

/* 卡片圆角统一到 20rpx 档 */
.card, .box, .item-card, .list-item, .cell {
  border-radius: 20rpx;
}
