/* pages/manage/pageSettings/pageSettings.wxss */
@import "/pages/public/wxss/form.wxss";

.setting-title {
  text-align: center;
  font-size: 36rpx;
  margin-top: 30rpx;
}

.setting-title-tip {
  color: var(--color-black-min);
  text-align: center;
  font-size: 26rpx;
}

.confirm {
  padding: 10rpx 30rpx 50rpx 30rpx;
}

checkbox {
  font-size: 26rpx;
}
/* =========================================================
   v5.1 全站统一外观（二级页自动套用）
   与首页/图库/详情页同一套：白底、细描边、大圆角、无重阴影
   ========================================================= */
page {
  background-color: var(--dk-bg);
  color: var(--dk-text);
}

/* 卡片圆角统一到 20rpx 档 */
.card, .box, .item-card, .list-item, .cell {
  border-radius: 20rpx;
}
