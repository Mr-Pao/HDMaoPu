/* 领养审核页 - 骨架复用 checkFeedbacks（已验证可正常渲染），配色走主题变量 */
page {
  width: 750rpx;
  padding: 250rpx 30rpx 150rpx 30rpx;
  box-sizing: border-box;
}

button {
  width: 47%;
  display: inline-block;
  font-size: 30rpx;
  box-sizing: border-box;
}

button.primary {
  background-color: var(--color-primary);
  color: var(--color-text-onPrimary);
}

button + button {
  margin-left: 5%;
}

/* 审核过程记录：独占一行 */
button.long {
  margin: 16rpx 0 0;
  width: 100%;
}

button.btn-note {
  color: var(--color-info);
  border: 1rpx solid var(--color-info);
  background: var(--color-surface);
}

button.btn-reject {
  color: var(--color-danger);
  border: 1rpx solid var(--color-danger);
  background: var(--color-surface);
}

/* 按钮行：拒绝/通过、取消/确认 —— 等宽铺满，两端对齐 */
.action-row,
.panel-buttons {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
}

.action-row { margin-top: 16rpx; }
.panel-buttons { margin-top: 24rpx; }

/* 覆盖全局 button 的固定宽度与 + 号间距，改由 flex 均分 */
.action-row button,
.panel-buttons button {
  flex: 1;
  width: auto;
  margin: 0;
}

/* 顶部固定栏 */
#tips {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  box-sizing: border-box;
  z-index: 1;
  font-size: 28rpx;
  color: var(--color-gray-max);
  box-shadow: 0rpx 0rpx 30rpx var(--color-gray);
  padding: 24rpx 30rpx;
  background-color: var(--color-surface);
}

#tips text {
  display: block;
  width: 100%;
  text-align: center;
}

/* 状态切换 */
.tabs {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
}

.tab {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  margin-right: 16rpx;
  background: var(--color-bg);
}

.tab.active {
  background: var(--color-primary);
  color: var(--color-text-onPrimary);
  font-weight: bold;
}

.empty {
  text-align: center;
  color: var(--color-text-tertiary);
  font-size: 28rpx;
  padding: 100rpx 0;
}

/* 审核面板（内嵌） */
.review-panel {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 0rpx 0rpx 30rpx var(--color-gray);
  border: 2rpx solid var(--color-primary);
  box-sizing: border-box;
}

.panel-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
}

.panel-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  text-align: center;
  margin-top: 12rpx;
}

.panel-textarea {
  background: var(--color-bg);
  border-radius: var(--radius-md);
  padding: 20rpx;
  width: 100%;
  height: 160rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  margin-top: 24rpx;
}

/* 申请卡片（复用 verify-box 骨架） */
.verify-box {
  box-sizing: border-box;
  margin-bottom: 50rpx;
  padding: 40rpx 40rpx 30rpx 40rpx;
  box-shadow: 0rpx 0rpx 30rpx var(--color-gray);
  border-radius: var(--radius-lg);
  background-color: var(--color-surface);
}

.line {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--color-black-light);
  margin-bottom: 16rpx;
}

.line image.icon {
  height: 40rpx;
  width: 40rpx;
  min-width: 40rpx;
  margin-right: 15rpx;
}

.line image.icon.cat-avatar {
  width: 56rpx;
  height: 56rpx;
  min-width: 56rpx;
  border-radius: 50%;
  background: var(--color-bg);
}

.line text {
  text-decoration: underline;
}

/* 状态徽章 */
.status-badge {
  font-size: 22rpx;
  font-weight: normal;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-pill);
  margin-left: auto;
  flex-shrink: 0;
}

.status-pending { background: var(--color-warning-soft); color: var(--color-warning); }
.status-reviewing { background: var(--color-info-soft); color: var(--color-info); }
.status-approved { background: var(--color-success-soft); color: var(--color-success); }
.status-rejected { background: var(--color-danger-soft); color: var(--color-danger); }
.status-cancelled { background: var(--color-bg); color: var(--color-text-tertiary); }

.status-bg-pending { background: var(--color-warning); }
.status-bg-reviewing { background: var(--color-info); }
.status-bg-approved { background: var(--color-success); }
.status-bg-rejected { background: var(--color-danger); }
.status-bg-cancelled { background: var(--color-text-tertiary); }

/* 气泡（复用 checkFeedbacks 结构） */
.bubble1, .bubble2 {
  margin-bottom: 12rpx;
}

.bubble1 .date, .bubble2 .date {
  font-size: 28rpx;
  color: var(--color-gray-max);
  text-align: left;
}

.bubble1 .name, .bubble2 .name {
  font-size: 28rpx;
  color: var(--color-gray-max);
}

.bubble1 .name { text-align: left; }
.bubble2 .name { text-align: left; }

.bubble1 .floating, .bubble2 .floating {
  width: max-content;
  max-width: 90%;
}

.bubble1 .floating { margin: 0; }
.bubble2 .floating { margin: 0 auto 0 0; }

.bubble1 .floating::after, .bubble2 .floating::after {
  display: block;
  content: "";
  clear: both;
}

.bubble1 .floating .content, .bubble2 .floating .content {
  clear: both;
  position: relative;
  border-radius: var(--radius-sm);
  padding: 12rpx 20rpx;
  font-size: 30rpx;
  line-height: 1.5;
}

.bubble1 .floating .content {
  float: left;
  background: var(--color-gray);
}

.bubble2 .floating .content {
  float: left;
  background: var(--color-primary);
  color: var(--color-text-onPrimary);
}

.bubble1 .floating .footer {
  float: left;
  clear: both;
  background-color: var(--color-bg);
  font-size: 28rpx;
  border-radius: var(--radius-sm);
  padding: 4rpx 20rpx;
  margin-top: 4rpx;
}

/* 流转记录 */
.timeline-toggle {
  font-size: 24rpx;
  color: var(--color-primary-text);
  margin: 12rpx 0;
  text-align: left;
}

.timeline {
  border-left: 4rpx solid var(--color-border);
  margin: 12rpx 0 12rpx 10rpx;
  padding-left: 24rpx;
}

.timeline-item {
  position: relative;
  padding-bottom: 24rpx;
}

.timeline-dot {
  position: absolute;
  left: -32rpx;
  top: 8rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.timeline-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.timeline-status {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--color-text);
}

.timeline-time {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.timeline-note {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  line-height: 1.5;
}

.timeline-operator {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
}
