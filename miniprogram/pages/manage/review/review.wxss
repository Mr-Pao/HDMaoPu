/* pages/manage/review/review.wxss */

/* ⚠️ app.wxss 里有个全局 .container{display:flex;align-items:center}，
   会把卡片压成内容宽度、整体居中（真机看着像缩在中间一条）。
   本页必须改回块级并撑满宽度，否则调什么都没用。 */
.container {
  display: block;
  width: 100%;
  padding: 24rpx 24rpx 48rpx;
  background-color: var(--dk-bg);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ==================== 头部 ==================== */
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.head-left {
  display: flex;
  align-items: baseline;
}

.head-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text);
}

.head-count {
  margin-left: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.head-refresh {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--color-border);
  background-color: var(--color-surface);
}

.head-refresh:active {
  background-color: var(--color-primary-softer);
}

.head-tip {
  font-size: 23rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 24rpx;
}

/* ==================== 状态 ==================== */
.loading {
  text-align: center;
  padding: 100rpx 0;
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

.empty {
  text-align: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 76rpx;
  margin-bottom: 18rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--color-text-tertiary);
}

/* ==================== 卡片 ==================== */
.card {
  background: var(--color-surface);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--color-border);
  box-sizing: border-box;
}

.card-top {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.tag {
  flex: none;
  font-size: 21rpx;
  line-height: 1.5;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  color: #FFFFFF;
  background: var(--color-primary);
}

.tag-photo {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.cat {
  margin-left: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text);
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.time {
  flex: none;
  font-size: 21rpx;
  color: var(--color-text-tertiary);
}

/* ---------- 图片 ---------- */
.photo-wrap {
  position: relative;
  width: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: var(--color-gray-light);
  margin-bottom: 14rpx;
}

.photo {
  display: block;
  width: 100%;
  height: 420rpx;
}

.photo-hint {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  background: rgba(0, 0, 0, 0.42);
}

/* ---------- 文案 ---------- */
.content {
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--color-text);
  word-break: break-all;
}

/* 一行小字信息，评论/照片共用，避免出现空行 */
.info {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
  margin-top: 14rpx;
}

.info-item {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* ==================== 操作 ==================== */
.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn:active {
  opacity: 0.86;
}

.btn-reject {
  color: var(--color-text-secondary);
  background: var(--color-gray-light);
  border: 1rpx solid var(--color-border);
}

.btn-approve {
  color: #FFFFFF;
  background: var(--color-primary);
}

/* 提交中：整卡的两个按钮都置灰，防止连点 */
.btn.is-busy {
  opacity: 0.5;
}

page {
  background-color: var(--dk-bg);
}

