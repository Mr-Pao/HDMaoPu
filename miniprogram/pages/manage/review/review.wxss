/* pages/manage/review/review.wxss */

.container {
  padding: 30rpx;
  background-color: var(--color-gray-light);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ==================== 头部 ==================== */
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.head-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-primary-text);
}

.head-tip {
  font-size: 24rpx;
  color: var(--color-gray-max);
  margin-bottom: 26rpx;
}

/* ==================== 状态 ==================== */
.loading {
  text-align: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: var(--color-gray-max);
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  font-size: 28rpx;
  color: var(--color-gray-max);
}

.empty-icon {
  font-size: 70rpx;
  margin-bottom: 20rpx;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-gray-normal, #bbb);
}

/* ==================== 卡片 ==================== */
.card {
  background: var(--color-surface);
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-top {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  color: var(--color-surface);
  background: var(--color-primary, #0C5F03);
}

.tag-photo {
  background: var(--color-primary-light, #8FBC94);
  color: #1F4A25;
}

.cat {
  margin-left: 14rpx;
  font-size: 26rpx;
  color: var(--color-primary-text);
  flex: 1;
}

.time {
  font-size: 22rpx;
  color: var(--color-gray-max);
}

.photo {
  width: 100%;
  height: 380rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  background: var(--color-gray-light);
}

.content {
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--color-primary-text);
  word-break: break-all;
}

.meta {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--color-gray-max);
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.btn-reject {
  color: #8A8A8A;
  background: var(--color-gray-light, #F2F2F2);
}

.btn-approve {
  color: var(--color-surface);
  background: var(--color-primary, #0C5F03);
}

/* =========================================================
   v5.1 全站统一外观（二级页自动套用）
   与首页/图库/详情页同一套：白底、细描边、大圆角、无重阴影
   ========================================================= */
page {
  background-color: var(--dk-bg);
  color: var(--dk-text);
}

/* 卡片圆角统一到 20rpx 档 */
.card, .box, .item-card, .list-item, .cell {
  border-radius: 20rpx;
}
