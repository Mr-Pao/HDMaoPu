/* pages/manage/review/review.wxss */

.container {
  padding: 30rpx;
  background-color: var(--color-gray-light);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ==================== 口令门 ==================== */
.gate {
  margin-top: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.gate-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.gate-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-primary, #0C5F03);
}

.gate-tip {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-gray-max);
}

.gate-input {
  margin-top: 50rpx;
  width: 520rpx;
  height: 88rpx;
  padding: 0 28rpx;
  background: var(--color-surface);
  border-radius: 16rpx;
  font-size: 30rpx;
  text-align: center;
  box-sizing: border-box;
}

.gate-error {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #D93025;
}

.gate-btn {
  margin-top: 40rpx;
  width: 520rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: var(--color-primary, #0C5F03);
  color: var(--color-surface);
  font-size: 32rpx;
}

.gate-btn::after {
  border: none;
}

/* ==================== 头部 ==================== */
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.head-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-primary-text);
}

.head-lock {
  font-size: 26rpx;
  color: var(--color-gray-max);
  padding: 8rpx 20rpx;
  border: 1rpx solid var(--color-gray-normal);
  border-radius: 24rpx;
}

.head-tip {
  font-size: 24rpx;
  color: var(--color-gray-max);
  margin-bottom: 26rpx;
}

/* ==================== 状态 ==================== */
.loading {
  text-align: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: var(--color-gray-max);
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  font-size: 28rpx;
  color: var(--color-gray-max);
}

.empty-icon {
  font-size: 70rpx;
  margin-bottom: 20rpx;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-gray-normal, #bbb);
}

/* ==================== 卡片 ==================== */
.card {
  background: var(--color-surface);
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-top {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  color: var(--color-surface);
  background: var(--color-primary, #0C5F03);
}

.tag-photo {
  background: var(--color-primary-light, #8FBC94);
  color: #1F4A25;
}

.cat {
  margin-left: 14rpx;
  font-size: 26rpx;
  color: var(--color-primary-text);
  flex: 1;
}

.time {
  font-size: 22rpx;
  color: var(--color-gray-max);
}

.photo {
  width: 100%;
  height: 380rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  background: var(--color-gray-light);
}

.content {
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--color-primary-text);
  word-break: break-all;
}

.meta {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--color-gray-max);
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.btn-reject {
  color: #8A8A8A;
  background: var(--color-gray-light, #F2F2F2);
}

.btn-approve {
  color: var(--color-surface);
  background: var(--color-primary, #0C5F03);
}
