page {
  height: 100%;
  background-color: var(--dk-bg);
  color: var(--dk-text);
  overflow: hidden;
}

.page {
  position: relative;
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
  /* 顶部一层极淡的品牌绿光晕，画面之外还有一层空间 */
  background:
    radial-gradient(120% 46% at 50% 0%, rgba(12, 95, 3, 0.12) 0%, rgba(12, 95, 3, 0) 64%),
    radial-gradient(90% 40% at 0% 100%, rgba(20, 128, 31, 0.08) 0%, rgba(20, 128, 31, 0) 60%),
    var(--dk-bg);
}

/* ============ 墙面：从最上沿铺到底部，含浮岛 tabBar 后面 ============ */
.stage {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  display: flex;
  align-items: stretch;
  z-index: 0;
}

.bands {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  /* 行间留一点缝，让每一条带子是独立的，不是一整块 */
  padding: 2rpx 0;
  box-sizing: border-box;
}

.band {
  overflow: hidden;
  min-height: 0;
  /* flex-grow 由 wxml 行内 style 按档位注入，三档拉开节奏 */
  flex: 1 1 0%;
  margin-bottom: 6rpx;
}
.band:last-child {
  margin-bottom: 0;
}

.track {
  display: inline-flex;
  width: max-content;
  height: 100%;
  will-change: transform;
}
/* 宽行向左漂、窄行向右漂 */
.dir-l {
  animation: marqueeL linear infinite;
}
.dir-r {
  animation: marqueeR linear infinite;
}

@keyframes marqueeL {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}
@keyframes marqueeR {
  from { transform: translateX(-50%); }
  to { transform: translateX(0); }
}

/* ============ 格子 ============ */
.cell {
  position: relative;
  flex-shrink: 0;
  margin-right: 6rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: rgba(12, 95, 3, 0.07);
  /* 极细内描边：深色墙上每格有轮廓，不糊成一团 */
  box-shadow: inset 0 0 0 1rpx rgba(12, 95, 3, 0.10);
  /* 逐张错峰淡入：开局不是「啪」地铺满，墙慢慢显影 */
  animation: cellIn 0.72s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.cell:last-child {
  margin-right: 0;
}

/* 三档格宽：hero 最宽，wide 次之，tall 最窄 */
.cell--hero {
  width: 430rpx;
  border-radius: 20rpx;
}
.cell--wide {
  width: 336rpx;
  border-radius: 16rpx;
}
.cell--tall {
  width: 238rpx;
  border-radius: 14rpx;
}

.cell-img {
  display: block;
  width: 100%;
  height: 100%;
  transform: scale(1.001);
}

@keyframes cellIn {
  from { opacity: 0; transform: scale(1.07); }
  to { opacity: 1; transform: scale(1); }
}

/* 每格底部压一点暗，墙面更沉，也压住亮图的刺眼感 */
.cell-veil {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 44%;
  background: linear-gradient(to top, rgba(16, 22, 15, 0.20) 0%, rgba(16, 22, 15, 0) 100%);
  pointer-events: none;
}

/* ============ 四面渐隐（渐到白底）============ */
.fade {
  position: absolute;
  z-index: 5;
  pointer-events: none;
}
.fade.top {
  left: 0;
  right: 0;
  top: 0;
  height: 22%;
  background: linear-gradient(
    to bottom,
    rgba(245, 247, 245, 0.97) 0%,
    rgba(245, 247, 245, 0.72) 38%,
    rgba(245, 247, 245, 0.24) 74%,
    rgba(245, 247, 245, 0) 100%
  );
}
.fade.bottom {
  left: 0;
  right: 0;
  bottom: 0;
  height: 36%;
  background: linear-gradient(
    to top,
    rgba(245, 247, 245, 0.99) 0%,
    rgba(245, 247, 245, 0.80) 32%,
    rgba(245, 247, 245, 0.34) 68%,
    rgba(245, 247, 245, 0) 100%
  );
}
/* 左右各 100rpx：看得到「有图进来」，但读不出细节 */
.fade.left {
  top: 0;
  bottom: 0;
  left: 0;
  width: 100rpx;
  background: linear-gradient(to right, rgba(245, 247, 245, 0.95) 0%, rgba(245, 247, 245, 0) 100%);
}
.fade.right {
  top: 0;
  bottom: 0;
  right: 0;
  width: 100rpx;
  background: linear-gradient(to left, rgba(245, 247, 245, 0.95) 0%, rgba(245, 247, 245, 0) 100%);
}

/* ============ HUD：不占布局的顶部标识 ============ */
.hud {
  position: fixed;
  left: 34rpx;
  z-index: 20;
  pointer-events: none;
}
.hud-row {
  display: flex;
  align-items: center;
}
.hud-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: var(--dk-accent);
  box-shadow: 0 0 16rpx rgba(12, 95, 3, 0.55);
}
.hud-kicker {
  color: var(--dk-text);
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 5rpx;
}
.hud-sep {
  margin: 0 12rpx;
  color: var(--dk-text-3);
  font-size: 18rpx;
}
.hud-count {
  color: var(--dk-text-2);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}
/* HUD 下一道青色细光：给标识一个落点，不至于飘在图上 */
.hud-line {
  margin-top: 12rpx;
  width: 132rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, rgba(12, 95, 3, 0.95) 0%, rgba(12, 95, 3, 0) 100%);
}

/* ============ 底部悬浮入口 ============ */
.wall-tip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 244rpx;
  bottom: calc(244rpx + constant(safe-area-inset-bottom));
  bottom: calc(244rpx + env(safe-area-inset-bottom));
  text-align: center;
  z-index: 2;
  pointer-events: none;
  color: var(--dk-text-2);
  font-size: 21rpx;
  letter-spacing: 2rpx;
  animation: tipBreath 3.4s ease-in-out infinite;
}

.dock {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 154rpx;
  bottom: calc(154rpx + constant(safe-area-inset-bottom));
  bottom: calc(154rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: center;
  z-index: 2;
  pointer-events: none;
}

@keyframes tipBreath {
  0%, 100% { opacity: 0.55; }
  50% { opacity: 1; }
}

.all-btn {
  display: flex;
  align-items: center;
  padding: 18rpx 36rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(12, 95, 3, 0.30);
  -webkit-backdrop-filter: blur(24rpx) saturate(160%);
  backdrop-filter: blur(24rpx) saturate(160%);
  box-shadow:
    0 14rpx 40rpx rgba(12, 95, 3, 0.14),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  pointer-events: auto;
}
.all-btn-hover {
  background: rgba(12, 95, 3, 0.08);
  transform: scale(0.98);
}
.all-text {
  color: var(--dk-text);
  font-size: 25rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.all-num {
  margin-left: 12rpx;
  color: var(--dk-accent);
  font-size: 26rpx;
  font-weight: 800;
}
.all-arrow {
  margin-left: 8rpx;
  color: var(--dk-accent);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
}

/* ============ 加载 / 空态 ============ */
.loading {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hint-text {
  color: var(--dk-text-3);
  font-size: 26rpx;
  letter-spacing: 2rpx;
}
.empty-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}
.empty-icon {
  font-size: 64rpx;
  margin-bottom: 18rpx;
}
.empty-text {
  color: var(--dk-text-2);
  font-size: 27rpx;
  font-weight: 600;
}
.empty-sub {
  margin-top: 12rpx;
  color: var(--dk-text-3);
  font-size: 22rpx;
  text-align: center;
  line-height: 1.65;
}

/* =========================================================
   v5.2 图库精修：HUD 更锐、墙更有纵深
   ========================================================= */

.hud-kicker {
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  color: var(--dk-text);
}
.hud-dot {
  width: 12rpx;
  height: 12rpx;
  box-shadow: 0 0 12rpx rgba(12, 95, 3, 0.65);
}
.hud-count {
  font-size: 21rpx;
  letter-spacing: 1rpx;
  color: var(--dk-text-2);
}
.hud-line {
  height: 2rpx;
  margin-top: 14rpx;
  background-image: linear-gradient(90deg, rgba(12, 95, 3, 0.55), rgba(12, 95, 3, 0.06) 60%, rgba(12, 95, 3, 0));
}

.cell {
  border: 2rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: 0 6rpx 18rpx rgba(12, 95, 3, 0.10);
}
.cell-img {
  display: block;
}

.all-btn {
  box-shadow: 0 10rpx 30rpx rgba(12, 95, 3, 0.16), inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
}
.all-text {
  font-weight: 700;
  letter-spacing: 1rpx;
}

/* =========================================================
   大图浮层：图下带「进入猫咪详情」入口
   ========================================================= */
.viewer {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: rgba(10, 14, 9, 0.95);
  animation: viewerIn 0.18s ease-out both;
}
@keyframes viewerIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
.viewer-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}
.viewer-img {
  position: relative;
  width: 750rpx;
  height: 62vh;
}
.viewer-bar {
  position: relative;
  padding: 34rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
}
.viewer-cat {
  width: 100%;
  display: flex;
  flex-direction: column;
  padding: 30rpx 34rpx 26rpx;
  box-sizing: border-box;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.10);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
}
.viewer-hover {
  opacity: 0.68;
}
.viewer-top {
  display: flex;
  align-items: baseline;
}
.viewer-cat-name {
  color: #FFFFFF;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.viewer-score {
  margin-left: 20rpx;
  color: #7BD88A;
  font-size: 30rpx;
  font-weight: 800;
}
.viewer-score-k {
  margin-left: 8rpx;
  color: rgba(255, 255, 255, 0.44);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}
.viewer-meta {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
}
.viewer-meta text {
  margin-right: 26rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 23rpx;
  letter-spacing: 0.5rpx;
}
.viewer-tags {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
}
.viewer-tag {
  margin: 0 12rpx 10rpx 0;
  padding: 5rpx 18rpx;
  border-radius: 999rpx;
  color: #B9E7C1;
  font-size: 20rpx;
  letter-spacing: 0.5rpx;
  background: rgba(20, 128, 31, 0.22);
  border: 1rpx solid rgba(123, 216, 138, 0.35);
}
.viewer-tag--num {
  color: rgba(255, 255, 255, 0.56);
  background: rgba(255, 255, 255, 0.07);
  border-color: rgba(255, 255, 255, 0.14);
}
.viewer-go {
  margin-top: 20rpx;
  padding-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
}
.viewer-go-t {
  color: rgba(255, 255, 255, 0.86);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}
.viewer-go-a {
  color: rgba(255, 255, 255, 0.66);
  font-size: 34rpx;
  line-height: 1;
}
.viewer-note {
  color: rgba(255, 255, 255, 0.50);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}
.viewer-close {
  margin-top: 26rpx;
  padding: 16rpx 60rpx;
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  letter-spacing: 2rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}
