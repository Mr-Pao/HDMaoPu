<view class="page">
  <!-- 漂流墙：从屏幕最上沿铺到底部，图片一直在横向缓慢漂移 -->
  <view class="stage" wx:if="{{!loading && rows.length}}">
    <view class="bands">
      <view class="band {{item.isWide ? 'band-w' : 'band-t'}}" wx:for="{{rows}}" wx:for-item="row" wx:key="index">
        <view class="track {{row.isWide ? 'dir-l' : 'dir-r'}}" style="animation-duration: {{row.duration}}s;">
          <view class="cell {{row.isWide ? 'wide' : 'tall'}}" wx:for="{{row.items}}" wx:for-item="pic" wx:key="key" bindtap="preview" data-url="{{pic.full}}">
            <image class="cell-img" src="{{pic.thumb}}" mode="aspectFill"></image>
            <view class="cell-veil"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 四面渐隐：让图淡进淡出，不留硬边 -->
    <view class="fade top"></view>
    <view class="fade bottom"></view>
    <view class="fade left"></view>
    <view class="fade right"></view>
  </view>

  <!-- HUD：不占布局，只贴一行极轻的标识 -->
  <view class="hud" style="top: {{statusBarHeight + 12}}px;">
    <view class="hud-row">
      <view class="hud-dot"></view>
      <text class="hud-kicker">CAT GALLERY</text>
      <text class="hud-sep">/</text>
      <text class="hud-count">{{total}} 张</text>
    </view>
    <view class="hud-line"></view>
  </view>

  <!-- 墙的注解 -->
  <text class="wall-tip" wx:if="{{!loading && rows.length}}">点任意一张看大图</text>

  <!-- 底部独立入口 -->
  <view class="dock" wx:if="{{!loading && rows.length}}">
    <view class="all-btn" hover-class="all-btn-hover" bindtap="reshuffle">
      <text class="all-text">换一批</text>
      <text class="all-num">{{total}}</text>
      <text class="all-arrow">›</text>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text class="hint-text">加载中...</text>
  </view>

  <view class="empty-box" wx:elif="{{!rows.length}}">
    <text class="empty-icon">🐾</text>
    <text class="empty-text">还没有照片</text>
    <text class="empty-sub">等猫友们上传之后，这里会变成一面猫猫墙</text>
  </view>
</view>
