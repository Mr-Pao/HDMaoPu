<view class="page">
  <!-- 漂流墙：从屏幕最上沿铺到底部，图片横向缓慢漂移 -->
  <view class="stage" wx:if="{{!loading && rows.length}}">
    <view class="bands">
      <view
        class="band"
        wx:for="{{rows}}"
        wx:for-item="row"
        wx:for-index="ri"
        wx:key="ri"
        style="flex-grow: {{row.grow}};"
      >
        <view
          class="track {{ri % 2 === 0 ? 'dir-l' : 'dir-r'}}"
          style="animation-duration: {{row.duration}}s; animation-delay: -{{row.delay}}s;"
        >
          <view
            class="cell cell--{{row.level}}"
            wx:for="{{row.items}}"
            wx:for-item="pic"
            wx:for-index="ci"
            wx:key="key"
            bindtap="preview"
            data-url="{{pic.full}}"
            data-catid="{{pic.cat_id}}"
            style="animation-delay: {{(ci % 12) * 45}}ms;"
          >
            <image class="cell-img" src="{{pic.thumb}}" mode="aspectFill"></image>
            <view class="cell-veil"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 四面渐隐：让图淡进淡出，不留硬边 -->
    <view class="fade top"></view>
    <view class="fade bottom"></view>
    <view class="fade left"></view>
    <view class="fade right"></view>
  </view>

  <!-- HUD：不占布局，只贴一行极轻的标识 -->
  <view class="hud" style="top: {{statusBarHeight + 14}}px;">
    <view class="hud-row">
      <view class="hud-dot"></view>
      <text class="hud-kicker">CAT GALLERY</text>
      <text class="hud-sep">/</text>
      <text class="hud-count">{{total}} 张</text>
    </view>
    <view class="hud-line"></view>
  </view>

  <!-- 墙的注解 -->
  <text class="wall-tip" wx:if="{{!loading && rows.length}}">点任意一张看大图</text>

  <!-- 底部独立入口 -->
  <view class="dock" wx:if="{{!loading && rows.length}}">
    <view class="all-btn" hover-class="all-btn-hover" bindtap="reshuffle">
      <text class="all-text">换一批</text>
      <text class="all-num">{{total}}</text>
      <text class="all-arrow">›</text>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text class="hint-text">加载中...</text>
  </view>

  <view class="empty-box" wx:elif="{{!rows.length}}">
    <text class="empty-icon">🐾</text>
    <text class="empty-text">还没有照片</text>
    <text class="empty-sub">等猫友们上传之后，这里会变成一面猫猫墙</text>
  </view>

  <!-- 大图浮层：图下直接给猫咪基本信息 -->
  <view class="viewer" wx:if="{{viewer.show}}" catchtouchmove="noop">
    <view class="viewer-mask" bindtap="closeViewer"></view>
    <image class="viewer-img" src="{{viewer.url}}" mode="aspectFit" bindtap="closeViewer"></image>
    <view class="viewer-bar">
      <view class="viewer-cat" wx:if="{{viewer.brief && viewer.brief.name}}" hover-class="viewer-hover" bindtap="toCatDetail">
        <view class="viewer-top">
          <text class="viewer-cat-name">{{viewer.brief.name}}</text>
          <text class="viewer-score">{{viewer.brief.score}}</text>
          <text class="viewer-score-k">猫德</text>
        </view>
        <view class="viewer-meta" wx:if="{{viewer.brief.where || viewer.brief.colour || viewer.brief.gender}}">
          <text wx:if="{{viewer.brief.where}}">{{viewer.brief.where}}</text>
          <text wx:if="{{viewer.brief.colour}}">{{viewer.brief.colour}}</text>
          <text wx:if="{{viewer.brief.gender}}">{{viewer.brief.gender}}</text>
        </view>
        <view class="viewer-tags" wx:if="{{viewer.brief.tags.length}}">
          <text class="viewer-tag" wx:for="{{viewer.brief.tags}}" wx:key="*this">{{item}}</text>
          <text class="viewer-tag viewer-tag--num">{{viewer.brief.photos}} 张照片</text>
        </view>
        <view class="viewer-go">
          <text class="viewer-go-t">进入猫咪详情</text>
          <text class="viewer-go-a">›</text>
        </view>
      </view>
      <view class="viewer-note" wx:else>这张照片还没挂到猫咪档案上</view>
      <view class="viewer-close" hover-class="viewer-hover" bindtap="closeViewer">关闭</view>
    </view>
  </view>
</view>
