<!--miniprogram/pages/genealogy/genealogy.wxml-->

<view class="dk-glow"></view>

<view id='search' class='{{filters_show_shadow? "shadow": ""}} {{filters_show? "solid": ""}}' style='height: {{heights.filters}}px; padding-top: {{heights.statusBarHeight}}px;'>
  <view class='nav-row'>
    <view class='nav-l'>
      <text class='nav-k'>MAOPU / CAMPUS CAT</text>
      <text class='nav-t'>火大猫谱</text>
    </view>
  </view>

  <view class='search-row'>
    <view class='input-block'>
      <view class='input-icon'>
        <image mode='aspectFit' src="/pages/public/images/filter/search.png"></image>
      </view>
      <input class='name' placeholder='{{text_cfg.genealogy.search_tip}}' placeholder-class='searchPlaceholderStyle' value='{{filters_input}}' focus='{{search_focus}}' maxlength='20' confirm-type='search' bindinput='fSearchInput' bindconfirm='fSearch'></input>
    </view>

    <view wx:if='{{showRecognize}}' class='nav-recognize' bindtap='clickRecognize'>
      <text class='nav-recognize-t'>识猫</text>
      <text class='nav-recognize-arrow'>›</text>
    </view>
    <view class='filter-btn {{filters_active? "on": ""}}' bindtap='fToggle'>
      <image wx:if='{{filters_active}}' mode='aspectFit' src="/pages/public/images/filter/filter_w.png"></image>
      <image wx:else mode='aspectFit' src="/pages/public/images/filter/filter.png"></image>
    </view>
  </view>
</view>

<!-- 点击过滤按钮出来的块 -->
<view wx:if='{{filters_show}}' id='filter-block' style='height: {{heights.windowHeight - heights.filters}}px;' catchtouchmove="voidMove" bindtap='fHide'>
  <view class='fsheet' catchtap='voidMove'>
    <!-- 三行胶囊：位置 / 花色 / 状态 -->
    <view class='filters'>
      <block wx:for="{{filters}}" wx:key="name" wx:for-index="rowIdx" wx:for-item="rowItem">
        <view class='frow'>
          <text class='frow-k'>{{rowItem.name}}</text>
          <scroll-view class='frow-scroll' scroll-x='1'>
            <view class='frow-inner'>
              <view class='fpill {{rowItem.all_active ? "on" : ""}}' catchtap='fRowAll' data-row='{{rowIdx}}'>全部</view>
              <view wx:for='{{rowItem.options}}' wx:for-item='opt' wx:for-index='optIdx' wx:key='name'
                    class='fpill {{opt.active ? "on" : ""}}' catchtap='fRowOpt' data-row='{{rowIdx}}' data-opt='{{optIdx}}'>
                <text>{{opt.name}}</text>
                <text class='fpill-n' wx:if='{{opt.count !== undefined}}'>{{opt.count}}</text>
              </view>
            </view>
          </scroll-view>
        </view>
      </block>
    </view>
    <!-- 来一条分割线 -->
    <view class='divider'></view>
    <!-- 按钮部分 -->
    <view class='buttons'>
      <view class='btn' bindtap='fRowReset'>重 置</view>
      <view class='btn {{filters_legal? "active": ""}}' bindtap='fHide'>完 成</view>
    </view>
  </view>
</view>

<scroll-view enable-flex='1' class='cards' style='height: {{heights.windowHeight - heights.filters}}px;' scroll-y='true' enable-back-to-top='true' bindscrolltolower='onReachBottom' bindscroll='fScroll' lower-threshold='{{main_lower_threshold}}' refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onPullDownRefresh">
  <!-- 顶部数据卡（整卡点击 → 数据看板） -->
  <view class='hero' bindtap='toDashboard'>
    <view class='hero-head'>
      <view class='hero-k'>CAMPUS CAT INDEX</view>
      <view class='hero-link'>
        <text class='hero-link-t'>数据看板</text>
        <text class='hero-link-arrow'>›</text>
      </view>
    </view>
    <view class='hero-row'>
      <view class='hero-cell {{hero_mode === "" ? "on" : ""}}' catchtap='heroFilter' data-type='all'>
        <text class='hero-n'>{{total_count || catsMax || cats.length}}</text>
        <text class='hero-k2'>在册</text>
      </view>
      <view class='hero-cell {{hero_mode === "adopt" ? "on" : ""}}' catchtap='heroFilter' data-type='adopt'>
        <text class='hero-n hero-n--accent'>{{adopt_count || 0}}</text>
        <text class='hero-k2'>待领养</text>
      </view>
      <view class='hero-cell {{hero_mode === "new" ? "on" : ""}}' catchtap='heroFilter' data-type='new'>
        <text class='hero-n'>{{new_count || 0}}</text>
        <text class='hero-k2'>本月新增</text>
      </view>
    </view>
  </view>

  <block wx:for='{{cats}}' wx:key="_id">
    <view class='row {{item.to_star? "row--star": ""}}' bindtap='clickCatCard' data-cat_id='{{item._id}}' data-index='{{index}}'>
      <view class='row-pic'>
        <image class='row-img' bindload="bindImageLoaded" mode='aspectFill' src='{{item.photo.photo_compressed || item.photo.photo_id}}' data-index="{{index}}" lazy-load="{{true}}"></image>
        <view class='row-new' wx:if="{{item.mphoto_new}}">{{text_cfg.genealogy.new_photo_tip}}</view>
        <view class='row-new row-new--empty' wx:elif='{{!item.photo_count_best || item.photo_count_best === 0}}'>{{text_cfg.genealogy.no_photo_tip}}</view>
      </view>

      <view class='row-main'>
        <view class='row-top'>
          <text class='row-name'>{{item.name}}</text>
          <image mode='aspectFill' class='row-sex' wx:if='{{item.gender === "公"}}' src="/pages/public/images/card/card/male.png"></image>
          <image mode='aspectFill' class='row-sex' wx:if='{{item.gender === "母"}}' src="/pages/public/images/card/card/female.png"></image>
          <view class='row-adopt' wx:if='{{item.adopt}}'>{{adopt_desc[item.adopt]}}</view>
          <view class='row-star' wx:if='{{item.to_star}}'>{{text_cfg.genealogy.to_star_tip}}</view>
        </view>

        <!-- v4.0.48 特点摘要（详情页看全文，这里两行省略） -->
        <view class='row-traits'>
          <view class='row-trait-v' wx:if='{{item.trait_text}}'>{{item.trait_text}}</view>
          <view class='row-trait-v row-trait-v--empty' wx:else>{{text_cfg.genealogy.traits_empty_tip}}</view>
        </view>

        <!-- v4.0.49 花色 + 位置同一行，放在猫德评分上方 -->
        <view class='row-meta'>
          <text class='row-chip' wx:if='{{item.colour}}'>{{item.colour}}</text>
          <text class='row-meta-t'>{{item.area ? item.campus + ' ' + item.area : (item.campus || '-')}}</text>
        </view>

        <view class='row-score'>
          <text class='row-score-v'>{{item.rating.avgScoreDisp || '0.0'}}</text>
          <view class='row-bar'>
            <view class='row-bar-fill' style='width: {{(item.rating.avgScore || 0) / 5 * 100}}%'></view>
          </view>
          <text class='row-score-k'>猫德</text>
        </view>

        <view class='row-nums'>
          <text class='row-num'>{{item.comment_count || 0}}<text class='row-num-k'>便利贴</text></text>
          <text class='row-sep'>|</text>
          <text class='row-num'>{{item.photo_count_total || 0}}<text class='row-num-k'>照片</text></text>
          <text class='row-sep'>|</text>
          <text class='row-num'>{{item.like_count || 0}}<text class='row-num-k'>点赞</text></text>
        </view>
      </view>
    </view>

    <!-- 广告 -->
    <view wx:if="{{adStep && (index+1)%adStep===0 && tipsList[(index+1)/adStep-1].tip.length>0}}" class='tips-wrap'>
      <text class="tips">{{tipsList[(index+1)/adStep-1].tip}}</text>
    </view>
  </block>

  <view class='loading' wx:if='{{!loadnomore}}'>
    <image src='/pages/public/images/system/loading.gif'></image>
  </view>
  <view class='loadnomore' wx:else>
    <image src='/pages/public/images/system/nomore.png'></image>
  </view>
  <!-- 底tab占位 -->
  <view style="height: {{tabBarHeight}}px;"></view>
</scroll-view>

<!-- 公告弹窗 -->
<view class="news-container">
  <newsModal id='newsModal' 
      title="{{newsList[0].title || ''}}"
      content="{{newsList[0].mainContent || ''}}"
      newsClass="{{newsList[0].class || ''}}"
      user="{{newsList[0].userNickname || ''}}"
      time="{{newsList[0].ddate || ''}}"
      imagePath="{{ newsImage }}"
      bind:cancelEvent="_cancelEvent"  
      bind:confirmEvent="_confirmEvent">
    </newsModal>
</view>