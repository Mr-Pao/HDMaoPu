<form bindsubmit="bindSubmit" wx:if="{{canFeedback}}">
  <!-- 昵称就地填（选填，不填就匿名），不拦提交 -->
  <view class='userInfo'>
    <text class='userInfo-title'>正在为「<text style="font-weight:600;">{{cat? cat.name: text_cfg.app_name}}</text>」反馈信息</text>
  </view>
  <view class='nicknameRow'>
    <input class='nicknameInput' type='text' placeholder='昵称（选填，不填就匿名）' value='{{nickname}}' bindinput='inputNickname' maxlength='20'/>
  </view>
  <view class='adminEntry' wx:if="{{isManager && cat && cat._id}}" bindtap='toAddRelation' hover-class='link-hover'>
    <view class='adminEntry-title'>管理</view>
    <view class='adminEntry-btn'>
      <text class='iconfont icon-relation'></text>
      <text>添加猫际关系</text>
    </view>
  </view>
  <view class='inputColumns'>
    <view>
      <text class='inputTitle'>{{text_cfg.feedback_detail.feedback_title}}：</text>
      <textarea class='feedbackColumn' placeholder="{{text_cfg.feedback_detail.feedback_tip}}" name='feedbackInfo' maxlength='{{maxlength}}' bindinput='bindInput' data-name="feedbackInfo"></textarea>
      <text class='lengthTips'>{{text_cfg.feedback_detail.input_length_tip}}：{{feedbackLength}}/{{maxlength}}</text>
    </view>
    <view style='margin-top:40rpx;'>
      <text class="inputTitle">{{text_cfg.feedback_detail.contract_title}}：</text>
      <input placeholder="{{text_cfg.feedback_detail.contract_tip}}" name='contactInfo' maxlength='30' bindinput='bindInput' data-name="contactInfo"/>
    </view>
  </view>
  <checkbox-group class="agreement" bindchange="changeAgreement">
    <checkbox color="var(--color-primary)" checked="{{agreementChecked}}">对于其他信息，您已阅读并同意<navigator url="/pages/info/agreement/agreement">《服务协议和隐私政策》</navigator></checkbox>
  </checkbox-group>
  <view class='submitButton'>
    <button form-type='submit' disabled="{{contactLength > 0 && !agreementChecked}}">{{text_cfg.feedback_detail.submit_button}}</button>
  </view>
</form>
<view class='footnote' wx:else>
  <text>*暂不开放反馈信息功能</text>
</view>
<view class='footnote'>
  <text>{{text_cfg.feedback_detail.submit_tip}}</text>
</view>
