/* miniprogram/pages/genealogy/genealogy.wxss */
@import "/pages/public/wxss/hFilter.wxss";

page {
  height: 100%;
  background-color: var(--color-bg);
}
/* 下面开始猫卡布局 */
scroll-view {
  -webkit-overflow-scrolling: touch;
  z-index: 0;
  background-color: var(--color-bg);
}

.cards{
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
}

.card {
  margin-bottom: 40rpx;
  font-size: 24rpx;
  line-height: 24rpx;
  width: 700rpx;
  border-radius: 32rpx;

  box-sizing: border-box;
  background-color: var(--color-surface);

  box-shadow: 0 8rpx 24rpx rgba(12, 95, 3, 0.08), 0 2rpx 6rpx rgba(12, 95, 3, 0.04);
  overflow: hidden;
  position: relative;
}

.card view.image {
  height: 520rpx;
  margin: 14rpx 14rpx 0 14rpx;
  border-radius: 24rpx;
  position: relative;
  overflow: hidden;
}

.card view.image .image-title{
  width: 100%;
  height: 44rpx;
  line-height: 44rpx;
  border-radius: 0 0 24rpx 24rpx;
  background-color: var(--color-black-light);
  opacity: .4;
  text-align: center;
  color: var(--color-surface);
  position: absolute;
  bottom: 0;
}

.card view.image image {
  width: 100%;
  height: 520rpx;
  border-radius: 24rpx;
  background-color: var(--color-gray-light);
	background-image: var(--img-default);
  background-position: center center;
  background-repeat: no-repeat;
  background-size: 50% 50%;
  position: absolute;
}

.card view.image.to_star image {
  filter: grayscale(100%);
}

.card .info {
  padding: 28rpx 34rpx 30rpx 34rpx;
}

.card .hoverInfo{
  background-color: var(--color-primary-softer);
  border-radius: 0 0 var(--radius-lg) var(--radius-lg);
}

.card .info .name {
  height: auto;
  font-size: 38rpx;
  line-height: 44rpx;

  font-weight: 700;
  letter-spacing: 1rpx;
}

.card .info image.gender {
  height: 27rpx;
  width: 27rpx;
  margin-right: 15rpx;
  margin-left: 8rpx;
}

.card .info .adopt {
  padding: 0 18rpx;
  height: 40rpx;
  border-radius: var(--radius-pill);
  font-size: 21rpx;
  line-height: 40rpx;
  text-align: center;
  color: var(--color-surface);
  background-color: var(--color-primary-bright);
  margin-left: 10rpx;
}

.card .info .to_star {
  height: 40rpx;
  border-radius: var(--radius-pill);
  font-size: 21rpx;
  line-height: 40rpx;
  text-align: center;
  color: var(--color-primary);
  background-color: var(--color-primary-soft);

  padding: 0 14rpx;
  margin: 0 10rpx;
}

.card .info .popularity {
  margin-left: auto;
  order: 2;
  display: flex;
  align-items: center;
}
.popularity image {
  height: 20rpx;
  width: 35rpx;
  margin-right: 8rpx;
}

.card .info .comment {
  margin-left: 15rpx;
  order: 2;
  display: flex;
  align-items: center;
}
.comment image {
  height: 27rpx;
  width: 27rpx;
  margin-right: 8rpx;
}

.card .line {
  display: flex;
  vertical-align: baseline;
  margin-bottom: 10rpx;

  color: var(--color-black-min);
  line-height: 1.05rem;
}

.card .line:first-child{
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  margin-left: 3rpx;
}

.card .line image.icon {
  height: 28rpx;
  width: 28rpx;
  min-width: 26rpx;
  margin-right: 20rpx;
  vertical-align: text-top;
}

.card .line .index {
  margin-left:auto;
  order:2;
  color: var(--color-gray);
}

.card .line .characteristics{
  line-height: 1.05rem;
  vertical-align: text-top;
}

.card .line .habit{
  line-height: 1.05rem;
  vertical-align: text-top;
}

.loading image {
  width: 165.9rpx;
  height: 90.3rpx;
  margin: 10rpx 292rpx;
}
.loadnomore image {
  width: 750rpx;
  height: 100rpx;
  margin: 10rpx 0;
}

/* 新图标签 */
.card .label {
  display: inline-block;
  text-align: center;
  background-color: var(--color-primary-bright);
  color: var(--color-surface);
  border-radius: var(--radius-pill);
  padding: 8rpx 22rpx;
  font-size: 22rpx;
  font-weight: 500;
  position: absolute;
  top: 32rpx;
  left: 32rpx;
  z-index: 2;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.16);
}

.card .label::after {
    content: none;
}

/* 广告栏 */

.card-ad {
  margin-bottom: 40rpx;
  width: 700rpx;
  border-radius: 32rpx;
  background-color: var(--color-surface);
  box-shadow: 0 8rpx 24rpx rgba(12, 95, 3, 0.08);
  overflow: hidden;

  display: flex;
  justify-content: center;
  align-items: center;

  min-height: 200rpx;
  box-sizing: border-box;

}

.card-ad.hidden {
  display: none;
}

/* 顶部的搜索框还有筛选 */
#search {
  width: 750rpx;
  background-color: var(--color-gray-light);
  box-sizing: border-box;

  display: flex;
  justify-content: flex-start;
  align-items: center;
  flex-wrap: nowrap;
}

#search.shadow {
  box-shadow: 0 0 10rpx var(--color-gray);
}

#search .input-block {
  width: 87%;
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  margin-left: 25rpx;
  background-color: var(--color-surface);
  border-radius: 999rpx;
  box-shadow: 0 2rpx 10rpx rgba(12, 95, 3, 0.07);
  padding: 0 8rpx;
}

#search .input-icon {
  width: 10%;
  height: 2.2rem;
  background-color: transparent;
  border-radius: 999rpx 0 0 999rpx;
  display: inline-block;
}

#search .input-icon image {
  width: 60%;
  height: 100%;
  margin: 0 20%;
}

#search input.name {
  width: 90%;
  height: 2.2rem;
  line-height: 2.2rem;
  background-color: transparent;
  border-radius: 0 999rpx 999rpx 0;
  display: inline-block;
  box-sizing: border-box;
  margin: 0;

  font-size: 80%;
}

#search .filter-btn {
  width: 10%;
  height: 55%;
  padding: 10rpx 0 10rpx 20rpx;
}

.filter-btn image {
  width: 70%;
  height: 100%;
}

/* 过滤器点开的部分 */
#filter-block {
  width: 750rpx;
  position: fixed;
  z-index: 2;
  background-color: rgba(0, 0, 0, .8);
}


#filter-block .filters {
  width: 100%;
  background-color: var(--color-surface);
  display: flex;
  flex-wrap: nowrap;
}

.f-column {
  padding: 0rpx 10rpx;
  height: 400rpx;
}
.f-column .padding-block {
  height: 20rpx;
}
.f-column-1 {
  width: 31%;
  box-sizing: border-box;
}

.f-column .item {
  height: 40rpx;
  font-size: 30rpx;
  line-height: 40rpx;
  margin: 10rpx;
  padding: 2rpx 20rpx;
  display: inline-flex;
  flex-wrap: nowrap;
  border: 3rpx solid transparent;
}

.f-column .item.active {
  color: var(--color-primary);
  border: 3rpx solid var(--color-primary);
  border-radius: 40rpx;
}

.f-column.main .item.active {
  color: black;
  background-color: var(--color-primary);
  border-radius: 40rpx;
}

.f-column .item .right-arrow {
  width: 20rpx;
  height: 40rpx;
  margin-left: 10rpx;

  display: inline-block;
}

.right-arrow image {
  height: 20rpx;
  width: 20rpx;
}

#filter-block .divider {
  width: 100%;
  height: 1rpx;
  background-color: var(--color-gray);
}

#filter-block .buttons {
  width: 100%;
  background-color: var(--color-gray);
  display: flex;
  justify-content: space-between;
}

#filter-block .buttons .btn {
  width: 374.8rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  background-color: var(--color-surface);
  color: var(--color-gray-dark);
  text-align: center;
}

#filter-block .buttons .active {
  color: var(--color-primary);
}

.searchPlaceholderStyle{
  display: flex;
}

/* 寻找领养按钮 */
#find-adopt {
  position: fixed;
  bottom: 300rpx;
  right: 30rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;

  filter: drop-shadow(0 0 5rpx var(--color-gray-dark));
  transform: translateZ(0);
}

/* 返回首页 */
#back-to-firstpage {
  position: fixed;
  bottom: 200rpx;
  right: 30rpx;

  filter: drop-shadow(0 0 5rpx var(--color-gray-dark));
  transform: translateZ(0);
}

#find-adopt .logo {
  width: 99rpx;
  height: 50rpx;
  display: block;
}

#find-adopt .count {
  font-size: 20rpx;
  padding: 1rpx 10rpx;
  background-color: var(--color-primary);
  border-radius: 5rpx;
  color: var(--color-black-light);
}

.adopt-filter-tip {
  position: fixed;
  top: 100rpx;
  right: 20rpx;
  opacity: 1;

  transition: top 1s, opacity 1s;
}

.adopt-filter-tip.hide {
  opacity: 0;
  top: 50rpx;
}

.adopt-filter-tip .tri {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 0 10rpx 10rpx 10rpx;
  border-color: transparent transparent var(--color-black-transparent) transparent;

  position: absolute;
  right: 20rpx;
}

.adopt-filter-tip .content {
  width: 180rpx;
  text-align: center;
  font-size: 22rpx;
  padding: 10rpx;
  background-color: var(--color-black-transparent);
  color: var(--color-surface);

  border-radius: 10rpx;
  
  position: absolute;
  right: 0;
  top: 10rpx;
}

.shake {
  animation-name: upAnimation;
  animation-duration: 2s;
  animation-fill-mode: both;
  animation-iteration-count: 6;
  animation-delay: 2s;
}
@keyframes upAnimation {
  0% {
      transform: rotate(0deg);
      transition-timing-function: cubic-bezier(0.215, .61, .355, 1)
  }

  10% {
      transform: rotate(-12deg);
      transition-timing-function: cubic-bezier(0.215, .61, .355, 1)
  }

  20% {
      transform: rotate(12deg);
      transition-timing-function: cubic-bezier(0.215, .61, .355, 1)
  }

  28% {
      transform: rotate(-10deg);
      transition-timing-function: cubic-bezier(0.215, .61, .355, 1)
  }

  36% {
      transform: rotate(10deg);
      transition-timing-function: cubic-bezier(0.755, .5, .855, .06)
  }

  42% {
      transform: rotate(-8deg);
      transition-timing-function: cubic-bezier(0.755, .5, .855, .06)
  }

  48% {
      transform: rotate(8deg);
      transition-timing-function: cubic-bezier(0.755, .5, .855, .06)
  }

  52% {
      transform: rotate(-4deg);
      transition-timing-function: cubic-bezier(0.755, .5, .855, .06)
  }

  56% {
      transform: rotate(4deg);
      transition-timing-function: cubic-bezier(0.755, .5, .855, .06)
  }

  60% {
      transform: rotate(0deg);
      transition-timing-function: cubic-bezier(0.755, .5, .855, .06)
  }

  100% {
      transform: rotate(0deg);
      transition-timing-function: cubic-bezier(0.215, .61, .355, 1)
  }
}


#back-to-firstpage .back-btn {
  width: 80rpx;
  height: 80rpx;
  margin: 0rpx 10rpx;
  display: block;
}

.news-container {
  z-index: 99;
}
/* 猫猫评分 */
.stars {
  width: 220rpx;
  height: 30rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.one-star {
  width: 30rpx;
  height: 30rpx;
}

.one-star.gray {
  filter: grayscale(100%);
  opacity: 0.3;
}

.one-star image {
  width: 100%;
  height: 100%;
}

.score {
  margin-left: 20rpx;
  width: 30rpx;
  text-align: center;
  color: var(--color-primary);
  font-weight: bold;
}

.tips{
  width: 600rpx;
  padding: 20rpx;
  margin-bottom: 40rpx;
  border-radius: 15rpx;
  background-color: var(--color-surface);
  color: var(--color-primary);
  box-shadow: 13rpx 13rpx 30rpx var(--color-gray);
  display: flex;
  justify-content: left;
  font-weight: bold;
}
/* ================= v4.2 首页重构：双列图鉴 ================= */
.cards {
  display: flex;
  flex-flow: row wrap;
  align-items: flex-start;
  align-content: flex-start;
  justify-content: space-between;
  padding: 0 22rpx;
  box-sizing: border-box;
}
.cards > .hero,
.cards > .h-filter-list,
.cards > .tips-wrap,
.cards > .loading,
.cards > .loadnomore {
  width: 100%;
  flex: 0 0 100%;
  box-sizing: border-box;
}

/* 顶部品牌区 */
.hero { padding: 34rpx 6rpx 22rpx; }
.hero-line { display: flex; align-items: baseline; }
.hero-title {
  font-size: 54rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: var(--color-primary);
  line-height: 64rpx;
}
.hero-count {
  margin-left: 14rpx;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}
.hero-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--color-text-tertiary);
}

/* 窄卡 */
.card {
  width: 346rpx;
  margin-bottom: 18rpx;
  border-radius: 22rpx;
  background-color: var(--color-surface);
  box-shadow: 0 4rpx 16rpx rgba(12, 95, 3, 0.06);
  overflow: hidden;
  position: relative;
  font-size: 22rpx;
  line-height: 22rpx;
}

.shot {
  position: relative;
  height: 420rpx;
  overflow: hidden;
  background-color: var(--color-gray-light);
}
.shot image {
  width: 100%;
  height: 420rpx;
  background-image: var(--img-default);
  background-position: center center;
  background-repeat: no-repeat;
  background-size: 45% 45%;
}
.shot.to_star image { filter: grayscale(100%); }

.shot-flag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 0 14rpx;
  height: 34rpx;
  line-height: 34rpx;
  font-size: 19rpx;
  color: var(--color-surface);
  background-color: var(--color-primary-bright);
  border-radius: var(--radius-pill);
}
.shot-flag--empty { background-color: rgba(31, 36, 33, 0.55); }

.shot-credit {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 14rpx;
  height: 40rpx;
  line-height: 40rpx;
  font-size: 19rpx;
  color: var(--color-surface);
  background: linear-gradient(to top, rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0));
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card .info { padding: 18rpx 20rpx 22rpx; }
.row-name { display: flex; align-items: center; }
.card .info .name {
  font-size: 32rpx;
  line-height: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--color-text);
  max-width: 240rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.card .info image.gender { width: 24rpx; height: 24rpx; margin-left: 8rpx; margin-right: 0; }

.chips { display: flex; flex-wrap: wrap; margin-top: 10rpx; }
.chip {
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 14rpx;
  border-radius: var(--radius-pill);
  font-size: 19rpx;
  margin-right: 8rpx;
}
.chip--adopt { color: var(--color-surface); background-color: var(--color-primary-bright); }
.chip--star { color: var(--color-primary); background-color: var(--color-primary-soft); }

.row-rating { display: flex; align-items: center; margin-top: 12rpx; }
.row-rating .stars { display: flex; align-items: center; }
.row-rating .one-star { width: 22rpx; height: 22rpx; margin-right: 3rpx; }
.row-rating .one-star image { width: 22rpx; height: 22rpx; display: block; }
.row-rating .one-star.gray image { opacity: 0.22; }
.row-rating .score {
  margin-left: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-warning);
}

.row-meta { display: flex; align-items: center; margin-top: 10rpx; }
.row-meta .where {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  max-width: 210rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.row-meta .cmt { margin-left: auto; font-size: 20rpx; color: var(--color-text-tertiary); }

.tips-wrap { padding: 6rpx 0 20rpx; text-align: center; }
.tips-wrap .tips {
  display: inline-block;
  padding: 10rpx 24rpx;
  border-radius: var(--radius-pill);
  background-color: var(--color-primary-softer);
  font-size: 20rpx;
  color: var(--color-text-secondary);
}


/* ================= v4.3 首页：沉浸式一屏一卡 ================= */
page {
  background-color: #0A2A06;
}
.cards {
  display: block;
  padding: 0 20rpx;
}
.cards > .h-filter-list {
  width: auto;
  margin: 6rpx 12rpx 14rpx 12rpx;
  padding: 8rpx 6rpx;
  border-radius: var(--radius-pill);
  background-color: rgba(255, 255, 255, 0.92);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.18);
  box-sizing: border-box;
}

.card {
  position: relative;
  width: 710rpx;
  height: calc(100vh - 250rpx);
  margin: 0 0 20rpx 0;
  border-radius: 44rpx;
  background-color: #123A0C;
  box-shadow: 0 18rpx 46rpx rgba(0, 0, 0, 0.35);
  overflow: hidden;
  font-size: 22rpx;
  line-height: 22rpx;
}

.shot {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  height: auto;
  background-color: #123A0C;
}
.shot image {
  width: 100%;
  height: 100%;
  border-radius: 0;
  background-image: var(--img-default);
  background-position: center center;
  background-repeat: no-repeat;
  background-size: 34% 34%;
}
.shot.to_star image { filter: grayscale(100%); }

.veil {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 500rpx;
  background: linear-gradient(
    to top,
    rgba(6, 26, 4, 0.94) 0%,
    rgba(6, 26, 4, 0.80) 26%,
    rgba(6, 26, 4, 0.42) 58%,
    rgba(6, 26, 4, 0) 100%
  );
  pointer-events: none;
}

.serial {
  position: absolute;
  top: 30rpx;
  right: 34rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.82);
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.45);
}

.card .shot-flag {
  position: absolute;
  top: 26rpx;
  left: 30rpx;
  padding: 0 18rpx;
  height: 42rpx;
  line-height: 42rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: var(--color-surface);
  background-color: var(--color-primary-bright);
  border-radius: var(--radius-pill);
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.3);
}
.card .shot-flag--empty { background-color: rgba(31, 36, 33, 0.62); }

.float {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  bottom: 40rpx;
}
.row-name {
  display: flex;
  align-items: center;
}
.card .info .name,
.float .name {
  font-size: 66rpx;
  line-height: 76rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: var(--color-surface);
  max-width: 500rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  text-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.5);
}
.row-name .gender {
  width: 34rpx;
  height: 34rpx;
  margin-left: 14rpx;
  padding: 6rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.92);
  box-sizing: border-box;
}

.float .row-rating {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.float .one-star {
  width: 30rpx;
  height: 30rpx;
  margin-right: 5rpx;
}
.float .one-star image {
  width: 30rpx;
  height: 30rpx;
  display: block;
}
.float .one-star.gray image { opacity: 0.3; }
.float .score {
  margin-left: 14rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #FFD24A;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.45);
}

.float .row-meta {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}
.float .where,
.float .cmt {
  font-size: 24rpx;
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.78);
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
}
.float .cmt { margin-left: auto; }
.float .where {
  max-width: 380rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
