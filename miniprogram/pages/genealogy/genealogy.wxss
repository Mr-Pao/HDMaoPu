/* miniprogram/pages/genealogy/genealogy.wxss */
@import "/pages/public/wxss/hFilter.wxss";

page {
  height: 100%;
  background-color: var(--color-bg);
}
/* 下面开始猫卡布局 */
scroll-view {
  -webkit-overflow-scrolling: touch;
  z-index: 0;
  background-color: var(--color-bg);
}

.cards{
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
}

.card {
  margin-bottom: 40rpx;
  font-size: 24rpx;
  line-height: 24rpx;
  width: 700rpx;
  border-radius: 32rpx;

  box-sizing: border-box;
  background-color: var(--color-surface);

  box-shadow: 0 8rpx 24rpx rgba(12, 95, 3, 0.08), 0 2rpx 6rpx rgba(12, 95, 3, 0.04);
  overflow: hidden;
  position: relative;
}

.card view.image {
  height: 520rpx;
  margin: 14rpx 14rpx 0 14rpx;
  border-radius: 24rpx;
  position: relative;
  overflow: hidden;
}

.card view.image .image-title{
  width: 100%;
  height: 44rpx;
  line-height: 44rpx;
  border-radius: 0 0 24rpx 24rpx;
  background-color: var(--color-black-light);
  opacity: .4;
  text-align: center;
  color: var(--color-surface);
  position: absolute;
  bottom: 0;
}

.card view.image image {
  width: 100%;
  height: 520rpx;
  border-radius: 24rpx;
  background-color: var(--color-gray-light);
	background-image: var(--img-default);
  background-position: center center;
  background-repeat: no-repeat;
  background-size: 50% 50%;
  position: absolute;
}

.card view.image.to_star image {
  filter: grayscale(100%);
}

.card .info {
  padding: 28rpx 34rpx 30rpx 34rpx;
}

.card .hoverInfo{
  background-color: var(--color-primary-softer);
  border-radius: 0 0 var(--radius-lg) var(--radius-lg);
}

.card .info .name {
  height: auto;
  font-size: 38rpx;
  line-height: 44rpx;

  font-weight: 700;
  letter-spacing: 1rpx;
}

.card .info image.gender {
  height: 27rpx;
  width: 27rpx;
  margin-right: 15rpx;
  margin-left: 8rpx;
}

.card .info .adopt {
  padding: 0 18rpx;
  height: 40rpx;
  border-radius: var(--radius-pill);
  font-size: 21rpx;
  line-height: 40rpx;
  text-align: center;
  color: var(--color-surface);
  background-color: var(--color-primary-bright);
  margin-left: 10rpx;
}

.card .info .to_star {
  height: 40rpx;
  border-radius: var(--radius-pill);
  font-size: 21rpx;
  line-height: 40rpx;
  text-align: center;
  color: var(--color-primary);
  background-color: var(--color-primary-soft);

  padding: 0 14rpx;
  margin: 0 10rpx;
}

.card .info .popularity {
  margin-left: auto;
  order: 2;
  display: flex;
  align-items: center;
}
.popularity image {
  height: 20rpx;
  width: 35rpx;
  margin-right: 8rpx;
}

.card .info .comment {
  margin-left: 15rpx;
  order: 2;
  display: flex;
  align-items: center;
}
.comment image {
  height: 27rpx;
  width: 27rpx;
  margin-right: 8rpx;
}

.card .line {
  display: flex;
  vertical-align: baseline;
  margin-bottom: 10rpx;

  color: var(--color-black-min);
  line-height: 1.05rem;
}

.card .line:first-child{
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  margin-left: 3rpx;
}

.card .line image.icon {
  height: 28rpx;
  width: 28rpx;
  min-width: 26rpx;
  margin-right: 20rpx;
  vertical-align: text-top;
}

.card .line .index {
  margin-left:auto;
  order:2;
  color: var(--color-gray);
}

.card .line .characteristics{
  line-height: 1.05rem;
  vertical-align: text-top;
}

.card .line .habit{
  line-height: 1.05rem;
  vertical-align: text-top;
}

.loading image {
  width: 165.9rpx;
  height: 90.3rpx;
  margin: 10rpx 292rpx;
}
.loadnomore image {
  width: 750rpx;
  height: 100rpx;
  margin: 10rpx 0;
}

/* 新图标签 */
.card .label {
  display: inline-block;
  text-align: center;
  background-color: var(--color-primary-bright);
  color: var(--color-surface);
  border-radius: var(--radius-pill);
  padding: 8rpx 22rpx;
  font-size: 22rpx;
  font-weight: 500;
  position: absolute;
  top: 32rpx;
  left: 32rpx;
  z-index: 2;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.16);
}

.card .label::after {
    content: none;
}

/* 广告栏 */

.card-ad {
  margin-bottom: 40rpx;
  width: 700rpx;
  border-radius: 32rpx;
  background-color: var(--color-surface);
  box-shadow: 0 8rpx 24rpx rgba(12, 95, 3, 0.08);
  overflow: hidden;

  display: flex;
  justify-content: center;
  align-items: center;

  min-height: 200rpx;
  box-sizing: border-box;

}

.card-ad.hidden {
  display: none;
}

/* 顶部的搜索框还有筛选 */
#search {
  width: 750rpx;
  background-color: var(--color-gray-light);
  box-sizing: border-box;

  display: flex;
  justify-content: flex-start;
  align-items: center;
  flex-wrap: nowrap;
}

#search.shadow {
  box-shadow: 0 0 10rpx var(--color-gray);
}

#search .input-block {
  width: 87%;
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  margin-left: 25rpx;
  background-color: var(--color-surface);
  border-radius: 999rpx;
  box-shadow: 0 2rpx 10rpx rgba(12, 95, 3, 0.07);
  padding: 0 8rpx;
}

#search .input-icon {
  width: 10%;
  height: 2.2rem;
  background-color: transparent;
  border-radius: 999rpx 0 0 999rpx;
  display: inline-block;
}

#search .input-icon image {
  width: 60%;
  height: 100%;
  margin: 0 20%;
}

#search input.name {
  width: 90%;
  height: 2.2rem;
  line-height: 2.2rem;
  background-color: transparent;
  border-radius: 0 999rpx 999rpx 0;
  display: inline-block;
  box-sizing: border-box;
  margin: 0;

  font-size: 80%;
}

.searchPlaceholderStyle{
  display: flex;
}

.news-container {
  z-index: 99;
}
/* 猫猫评分 */
.stars {
  width: 220rpx;
  height: 30rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.one-star {
  width: 30rpx;
  height: 30rpx;
}

.one-star.gray {
  filter: grayscale(100%);
  opacity: 0.3;
}

.one-star image {
  width: 100%;
  height: 100%;
}

.score {
  margin-left: 20rpx;
  width: 30rpx;
  text-align: center;
  color: var(--color-primary);
  font-weight: bold;
}

.tips{
  width: 600rpx;
  padding: 20rpx;
  margin-bottom: 40rpx;
  border-radius: 15rpx;
  background-color: var(--color-surface);
  color: var(--color-primary);
  box-shadow: 13rpx 13rpx 30rpx var(--color-gray);
  display: flex;
  justify-content: left;
  font-weight: bold;
}
/* =========================================================
   v5.0 首页：深空沉浸
   近黑微绿底 + 玻璃卡 + 发丝描边 + 亮绿强调 + 大号数据
   ========================================================= */
page {
  background-color: var(--dk-bg);
}

.cards {
  display: block;
  background-color: transparent;
  padding: 0 24rpx;
  box-sizing: border-box;
}

/* ---------- 顶部：自绘导航 + 玻璃搜索 ---------- */
#search {
  width: 750rpx;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  padding-left: 32rpx;
  padding-right: 32rpx;
  background-color: transparent;
  background-image: linear-gradient(
    180deg,
    rgba(245, 247, 245, 0.99) 0%,
    rgba(245, 247, 245, 0.94) 68%,
    rgba(245, 247, 245, 0) 100%
  );
  z-index: 30;
}

#search.shadow {
  box-shadow: none;
}

.nav-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding-bottom: 12rpx;
}

.nav-l {
  display: flex;
  flex-direction: column;
}

.nav-k {
  font-size: 19rpx;
  letter-spacing: 4rpx;
  color: var(--dk-text-3);
}

.nav-t {
  font-size: 46rpx;
  line-height: 50rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  color: var(--dk-text);
  margin-top: 8rpx;
}

.nav-r {
  display: flex;
  align-items: baseline;
}

.nav-n {
  font-size: 46rpx;
  line-height: 50rpx;
  font-weight: 800;
  letter-spacing: -1.5rpx;
  color: var(--dk-accent);
}

.nav-nk {
  font-size: 19rpx;
  letter-spacing: 1rpx;
  color: var(--dk-text-3);
  margin-left: 8rpx;
}

.search-row {
  display: flex;
  align-items: center;
  flex: 1;
}

#search .input-block {
  flex: 1;
  width: auto;
  height: 84rpx;
  margin-left: 0;
  padding: 0 26rpx;
  box-sizing: border-box;
  background-color: var(--dk-card);
  border: 1rpx solid var(--dk-line);
  border-radius: var(--dk-radius-pill);
  box-shadow: none;
  display: flex;
  align-items: center;
}

#search .input-icon {
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
  background-color: transparent;
  border-radius: 0;
}

#search .input-icon image {
  width: 30rpx;
  height: 30rpx;
  margin: 0;
  opacity: 0.55;
}

#search input.name {
  flex: 1;
  width: auto;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 26rpx;
  color: var(--dk-text);
  background-color: transparent;
  border-radius: 0;
}

.searchPlaceholderStyle {
  display: flex;
  color: rgba(16, 22, 15, 0.32);
}

/* ---------- 数据卡 ---------- */
.hero {
  margin: 8rpx 0 22rpx 0;
  padding: 28rpx 30rpx 24rpx 30rpx;
  background-color: var(--dk-card);
  border: 1rpx solid var(--dk-line);
  border-radius: var(--dk-radius-lg);
  box-sizing: border-box;
}

.hero-k {
  font-size: 18rpx;
  letter-spacing: 4rpx;
  color: var(--dk-text-3);
}

.hero-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.hero-link {
  display: flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background-color: var(--dk-accent-soft);
  border: 1rpx solid var(--dk-accent-line);
}

.hero-link-t {
  font-size: 21rpx;
  line-height: 26rpx;
  color: var(--dk-accent);
  font-weight: 600;
  letter-spacing: 1rpx;
}

.hero-link-arrow {
  font-size: 26rpx;
  line-height: 24rpx;
  color: var(--dk-accent);
  margin-left: 6rpx;
}

.hero-row {
  display: flex;
  align-items: flex-end;
  margin-top: 22rpx;
}

.hero-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  border-left: 1rpx solid var(--dk-line);
}

.hero-cell:first-child {
  border-left: none;
}

.hero-n {
  font-size: 52rpx;
  line-height: 56rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
  color: var(--dk-text);
}

.hero-n--accent {
  color: var(--dk-accent);
}

.hero-k2 {
  font-size: 19rpx;
  letter-spacing: 1rpx;
  color: var(--dk-text-3);
  margin-top: 6rpx;
}

/* ---------- 筛选按钮 ---------- */
#search .filter-btn {
  width: 84rpx;
  height: 84rpx;
  flex: 0 0 84rpx;
  margin-left: 16rpx;
  padding: 0;
  background-color: var(--dk-card);
  border: 1rpx solid var(--dk-line);
  border-radius: var(--dk-radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
}

#search .filter-btn image {
  width: 34rpx;
  height: 34rpx;
  opacity: 0.8;
}

/* ---------- 筛选抽屉（三行胶囊，抽屉骨架沿用原版） ---------- */
#filter-block {
  width: 750rpx;
  position: fixed;
  z-index: 2;
  background-color: rgba(0, 0, 0, .8);
}

.frow {
  width: 100%;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-sizing: border-box;
  margin-top: 14rpx;
}

.frow:first-child {
  margin-top: 0;
}

.frow-k {
  width: 78rpx;
  flex-shrink: 0;
  font-size: 21rpx;
  letter-spacing: 1rpx;
  color: var(--dk-text-3);
}

.frow-scroll {
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
}

.frow-inner {
  display: inline-flex;
  align-items: center;
}

.fpill {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 26rpx;
  margin-right: 12rpx;
  border-radius: var(--dk-radius-pill);
  font-size: 23rpx;
  letter-spacing: 0.5rpx;
  color: var(--dk-text-2);
  background-color: transparent;
  border: 1rpx solid var(--dk-line);
  box-sizing: border-box;
}

.fpill.on {
  color: #FFFFFF;
  background-color: var(--dk-accent);
  border-color: var(--dk-accent);
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(12, 95, 3, 0.18);
}

.fpill-n {
  font-size: 19rpx;
  margin-left: 8rpx;
  opacity: 0.55;
}

.fpill.on .fpill-n {
  opacity: 0.85;
}

/* ---------- 列表卡 ---------- */
.row {
  display: flex;
  align-items: stretch;
  padding: 18rpx;
  margin-bottom: 18rpx;
  background-color: var(--dk-card);
  border: 1rpx solid var(--dk-line);
  border-radius: var(--dk-radius-lg);
  box-sizing: border-box;
}

.row--star {
  background-color: rgba(12, 95, 3, 0.03);
}

.row-pic {
  position: relative;
  width: 208rpx;
  height: 208rpx;
  flex: 0 0 208rpx;
  margin-right: 22rpx;
  border-radius: var(--dk-radius);
  overflow: hidden;
  background-color: rgba(12, 95, 3, 0.06);
}

.row-img {
  width: 208rpx;
  height: 208rpx;
  border-radius: var(--dk-radius);
  display: block;
}

.row--star .row-img {
  filter: grayscale(0.7) brightness(0.82);
}

.row-new {
  position: absolute;
  left: 0;
  bottom: 0;
  font-size: 17rpx;
  letter-spacing: 1rpx;
  color: #FFFFFF;
  background-color: var(--dk-accent);
  padding: 5rpx 14rpx;
  border-radius: 0 14rpx 0 14rpx;
  font-weight: 700;
}

.row-new--empty {
  color: rgba(255, 255, 255, 0.92);
  background-color: rgba(16, 22, 15, 0.62);
  font-weight: 400;
}

.row-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0 2rpx 0;
  min-width: 0;
}

.row-top {
  display: flex;
  align-items: center;
}

.row-name {
  font-size: 38rpx;
  line-height: 42rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
  color: var(--dk-text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.row-sex {
  width: 26rpx;
  height: 26rpx;
  margin-left: 10rpx;
  opacity: 0.65;
}

.row-adopt {
  margin-left: 12rpx;
  font-size: 18rpx;
  letter-spacing: 1rpx;
  color: var(--dk-accent-2);
  background-color: var(--dk-accent-soft);
  border: 1rpx solid var(--dk-accent-line);
  border-radius: var(--dk-radius-pill);
  padding: 4rpx 14rpx;
  font-weight: 600;
}

.row-star {
  margin-left: 8rpx;
  font-size: 18rpx;
  letter-spacing: 1rpx;
  color: var(--dk-text-3);
  background-color: rgba(12, 95, 3, 0.06);
  border-radius: var(--dk-radius-pill);
  padding: 4rpx 14rpx;
}

/* 评分条 */
.row-score {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.row-score-v {
  font-size: 30rpx;
  line-height: 32rpx;
  font-weight: 700;
  color: var(--dk-accent);
  min-width: 66rpx;
}

.row-bar {
  flex: 1;
  height: 8rpx;
  border-radius: var(--dk-radius-pill);
  background-color: rgba(12, 95, 3, 0.12);
  overflow: hidden;
  margin-right: 12rpx;
}

.row-bar-fill {
  height: 8rpx;
  border-radius: var(--dk-radius-pill);
  background-color: var(--dk-accent);
}

.row-score-k {
  font-size: 18rpx;
  letter-spacing: 1rpx;
  color: var(--dk-text-3);
}

.row-where {
  font-size: 21rpx;
  letter-spacing: 0.5rpx;
  color: var(--dk-text-2);
  margin-top: 10rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.row-nums {
  display: flex;
  align-items: baseline;
  margin-top: 10rpx;
}

.row-num {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--dk-text);
}

.row-num-k {
  font-size: 18rpx;
  font-weight: 400;
  color: var(--dk-text-3);
  margin-left: 4rpx;
}

.row-sep {
  font-size: 17rpx;
  color: rgba(16, 22, 15, 0.20);
  margin: 0 12rpx;
}

/* 提示 / 加载 */
.tips-wrap {
  width: 100%;
  padding: 0 4rpx 22rpx 4rpx;
}

.tips {
  width: auto;
  color: var(--dk-text-2);
  background-color: transparent;
  box-shadow: none;
  font-weight: 400;
  font-size: 21rpx;
  letter-spacing: 0.5rpx;
  padding: 0;
  margin: 0;
}

.loading image,
.loadnomore image {
  opacity: 0.42;
}

.loading,
.loadnomore {
  padding: 26rpx 0 14rpx 0;
}

.loading image {
  margin: 10rpx 292rpx;
}

/* =========================================================
   v5.2 首页精修：更大的数字、更透的卡片、更稳的层次
   ========================================================= */

/* 顶部导航：数字更有分量 */
.nav-t {
  font-size: 50rpx;
  letter-spacing: -1rpx;
}
.nav-n {
  font-size: 54rpx;
  letter-spacing: -2rpx;
  line-height: 1;
}
.nav-nk {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  margin-top: 4rpx;
}

/* 数据卡：从"一排数字"升级为"巨号数字 + 发丝分隔栏" */
.hero {
  margin: 6rpx 24rpx 20rpx 24rpx;
  padding: 34rpx 30rpx 30rpx 30rpx;
  border-radius: 32rpx;
  background-image: linear-gradient(135deg, rgba(12, 95, 3, 0.06), rgba(12, 95, 3, 0.015) 46%, rgba(12, 95, 3, 0) 70%);
  background-color: var(--dk-card);
  border: 1rpx solid var(--dk-line);
  box-shadow: 0 2rpx 12rpx rgba(12, 95, 3, 0.04);
}
.hero-k {
  font-size: 19rpx;
  letter-spacing: 5rpx;
  color: var(--dk-text-3);
  font-weight: 700;
}
.hero-k::after {
  content: '';
  display: block;
  width: 56rpx;
  height: 4rpx;
  margin-top: 12rpx;
  border-radius: 2rpx;
  background-color: var(--dk-accent);
  opacity: 0.85;
}
.hero-row {
  display: flex;
  align-items: flex-end;
  margin-top: 26rpx;
}
.hero-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  border-left: 1rpx solid var(--dk-line);
}
.hero-cell:first-child {
  border-left: none;
}
.hero-n {
  font-size: 62rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
  line-height: 1.05;
  color: var(--dk-text);
}
.hero-n--accent {
  color: var(--dk-accent);
}
.hero-k2 {
  font-size: 19rpx;
  letter-spacing: 1rpx;
  color: var(--dk-text-3);
  margin-top: 8rpx;
}

/* 三格数字可点筛选：默认给一点可点暗示，选中态整格报绿 */
.hero-cell {
  position: relative;
  transition: opacity 160ms ease;
}
.hero-cell .hero-n {
  transition: color 160ms ease;
}
.hero-cell.on .hero-n {
  color: var(--dk-accent);
}
.hero-cell.on .hero-k2 {
  color: var(--dk-accent);
  font-weight: 600;
}
.hero-cell.on::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: -12rpx;
  width: 34rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background-color: var(--dk-accent);
}
.hero-cell:first-child.on::after {
  left: 50%;
}

/* 列表卡：图片更圆、信息更透气 */
.row {
  margin: 0 24rpx 18rpx 24rpx;
  padding: 18rpx;
  border-radius: 30rpx;
  background-color: var(--dk-card);
  border: 1rpx solid var(--dk-line);
  box-shadow: 0 2rpx 10rpx rgba(12, 95, 3, 0.035);
}
.row-pic,
.row-img {
  border-radius: 22rpx;
}
.row-name {
  font-size: 40rpx;
  letter-spacing: -0.5rpx;
}
.row-num {
  font-size: 26rpx;
}
.row-bar {
  height: 10rpx;
  border-radius: 6rpx;
}
.row-bar-fill {
  border-radius: 6rpx;
  background-image: linear-gradient(90deg, rgba(12, 95, 3, 0.55), var(--dk-accent));
}

/* =========================================================
   v5.3 首页外观：筛选抽屉重做 + 顶部留白 + 提示条成条
   ========================================================= */

/* ---------- 筛选抽屉：从搜索栏下方往下摊开，下方是黑罩 ---------- */
#filter-block {
  left: 0;
  right: 0;
  background-color: rgba(16, 22, 15, 0.42);
  /* 内容贴顶，向下展开 */
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.fsheet {
  width: 100%;
  padding: 0;
  background-color: var(--dk-bg);
  border-radius: 0;
  box-shadow: none;
  box-sizing: border-box;
  text-align: center;
  transform-origin: top center;
  animation: sheetDown 0.22s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

/* 抽屉打开时搜索栏改用实心底，否则底部渐隐会透出遮罩，在面板上方留下一道深色裂缝 */
#search.solid {
  background-image: none;
  background-color: var(--dk-bg);
}

@keyframes sheetDown {
  from {
    clip-path: inset(0 0 100% 0);
  }
  to {
    clip-path: inset(0 0 0 0);
  }
}

.fsheet .filters {
  width: 100%;
  padding: 22rpx 0 4rpx;
  background-color: transparent;
  display: flex;
  flex-direction: column;
}

.fsheet .frow {
  margin-top: 20rpx;
}

.fsheet .frow:first-child {
  margin-top: 0;
}

.fsheet .frow-k {
  width: 80rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  font-weight: 600;
  color: var(--dk-text-3);
  text-align: left;
  white-space: nowrap;
}

.fsheet .fpill {
  height: 62rpx;
  padding: 0 28rpx;
  margin-right: 14rpx;
  font-size: 25rpx;
  background-color: var(--dk-card);
  border-color: var(--dk-line);
}

.fsheet .fpill.on {
  color: #FFFFFF;
  background-color: var(--dk-accent);
  border-color: var(--dk-accent);
  box-shadow: 0 6rpx 16rpx rgba(12, 95, 3, 0.22);
}

.fsheet .divider {
  display: none;
}

.fsheet .buttons {
  width: 100%;
  margin: 20rpx 0 0 0;
  padding: 0;
  background-color: var(--dk-bg);
  display: flex;
  justify-content: flex-start;
}

.fsheet .buttons .btn {
  width: 50%;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 29rpx;
  letter-spacing: 4rpx;
  border-radius: 0;
  background-color: transparent;
  color: var(--dk-text-2);
  font-weight: 600;
}

.fsheet .buttons .btn.active {
  background-color: var(--dk-accent);
  color: #FFFFFF;
  box-shadow: none;
}

/* ---------- 顶部：标题区呼吸感 + 搜索行更整 ---------- */
.nav-row {
  padding: 6rpx 0 20rpx 0;
  align-items: center;
}

.nav-k {
  font-size: 18rpx;
  letter-spacing: 3.4rpx;
  opacity: 0.72;
}

.nav-t {
  font-size: 52rpx;
  line-height: 56rpx;
  letter-spacing: -1.6rpx;
  margin-top: 10rpx;
}

.search-row {
  padding-bottom: 20rpx;
}

#search .input-block {
  height: 80rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 10rpx rgba(12, 95, 3, 0.05);
}

#search input.name {
  height: 80rpx;
  line-height: 80rpx;
  font-size: 27rpx;
}

#search .filter-btn {
  width: 80rpx;
  height: 80rpx;
  flex: 0 0 80rpx;
  margin-left: 18rpx;
  box-shadow: 0 2rpx 10rpx rgba(12, 95, 3, 0.05);
}

#search .filter-btn.on {
  background-color: var(--dk-accent);
  border-color: var(--dk-accent);
}

/* ---------- 广告提示：从裸文本变成一条浅绿提示条 ---------- */
.tips-wrap {
  width: 100%;
  /* width:100% + 左右 padding 时，content-box 会整体宽出 48rpx，
     右边比猫卡多冒出去 24rpx —— 必须 border-box 才能和 .row 对齐 */
  box-sizing: border-box;
  padding: 4rpx 24rpx 22rpx 24rpx;
}

.tips {
  display: block;
  padding: 18rpx 24rpx 18rpx 26rpx;
  border-radius: 20rpx;
  background-color: rgba(12, 95, 3, 0.045);
  border-left: 4rpx solid var(--dk-accent-line);
  font-size: 22rpx;
  line-height: 34rpx;
  letter-spacing: 0.3rpx;
  color: var(--dk-text-2);
  box-sizing: border-box;
}

/* =========================================================
   v5.4 主题色强化：绿色面积与对比度（品牌色 #0C5F03 不变，
   大面积填充改用亮绿 --dk-accent-2 #14801F）
   ========================================================= */

/* ---------- 1) 顶部标题区：小标从灰改亮绿 ---------- */
.nav-k { color: var(--dk-accent-2); font-weight: 700; opacity: 1; }

/* ---------- 2) 搜索框与筛选按钮：描边/阴影统一到绿系 ---------- */
#search .input-block { border-color: var(--dk-accent-line); box-shadow: 0 2rpx 12rpx rgba(12, 95, 3, 0.08); }
#search .input-block image { opacity: 0.85; }
#search .filter-btn { border-color: var(--dk-accent-line); }
#search .filter-btn.on { background-color: var(--dk-accent-2); border-color: var(--dk-accent-2); box-shadow: 0 6rpx 16rpx rgba(20, 128, 31, 0.32); }

/* ---------- 3) 数据卡 hero：绿色面积最大的一块 ---------- */
.hero {
  background-image: linear-gradient(135deg, rgba(20, 128, 31, 0.18), rgba(20, 128, 31, 0.06) 52%, rgba(20, 128, 31, 0.02) 78%);
  border-color: rgba(20, 128, 31, 0.20);
  box-shadow: 0 4rpx 20rpx rgba(12, 95, 3, 0.10);
}
.hero-k { color: var(--dk-accent-2); font-weight: 700; }
.hero-k::after { width: 84rpx; height: 6rpx; background-color: var(--dk-accent-2); opacity: 1; }
.hero-link { background-color: var(--dk-accent-2); border-color: var(--dk-accent-2); box-shadow: 0 4rpx 12rpx rgba(20, 128, 31, 0.28); }
.hero-link-t { color: #FFFFFF; font-weight: 700; }
.hero-link-arrow { color: #FFFFFF; opacity: 0.9; }
.hero-row { margin-top: 24rpx; }
.hero-cell { border-left-color: rgba(20, 128, 31, 0.18); padding: 10rpx 0 12rpx; border-radius: 18rpx; }
.hero-n { color: var(--dk-accent-2); }
.hero-n--accent { color: var(--dk-accent-2); }
.hero-k2 { color: var(--dk-text-2); }

/* 选中格：整格铺浅绿底 + 数字加深，替代原来那根小短横线
   （短横线用 height/opacity 归零隐藏，不动 display） */
.hero-cell.on { background-color: rgba(20, 128, 31, 0.12); }
.hero-cell.on .hero-n { color: var(--dk-accent); }
.hero-cell.on .hero-k2 { color: var(--dk-accent); font-weight: 700; }
.hero-cell.on::after { height: 0; opacity: 0; background-color: transparent; }

/* ---------- 4) 猫列表卡 ---------- */
.row { border-color: rgba(20, 128, 31, 0.14); }
.row-adopt { color: #FFFFFF; background-color: var(--dk-accent-2); border-color: var(--dk-accent-2); font-weight: 700; }
.row-score-v { color: var(--dk-accent-2); }
.row-bar { height: 10rpx; background-color: rgba(20, 128, 31, 0.16); }
.row-bar-fill { height: 10rpx; background-image: linear-gradient(90deg, var(--dk-accent-2), #1FA34A); }
.row-num { color: var(--dk-accent-2); }
.row-num-k { color: var(--dk-text-3); }

/* ---------- 5) 公告提示条 tips ---------- */
.tips { background-color: rgba(20, 128, 31, 0.09); border-left-color: var(--dk-accent-2); }

/* ---------- 6) 筛选抽屉 .fsheet ---------- */
.fsheet .frow-k { color: var(--dk-accent-2); font-weight: 700; }
.fsheet .fpill { background-color: #FFFFFF; border-color: rgba(20, 128, 31, 0.16); }
.fsheet .fpill.on { background-color: var(--dk-accent-2); border-color: var(--dk-accent-2); box-shadow: 0 6rpx 18rpx rgba(20, 128, 31, 0.34); }
.fsheet .fpill.on .fpill-n { opacity: 1; }
.fsheet .buttons .btn { color: var(--dk-text-2); }
.fsheet .buttons .btn.active { background-color: var(--dk-accent-2); box-shadow: 0 0 0 0 rgba(0,0,0,0); }
