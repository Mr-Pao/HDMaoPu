@import "../../../packages/weui/weui-wxss/dist/style/weui.wxss";

page {
  height: 100%;
  overflow: hidden;
  background-color: var(--color-bg);
}
#bg-yellow {
  width: 750rpx;
  height: 1000rpx;
  background-color: var(--color-primary);
  position: fixed;
  z-index: -1;
}
#bg-yellow.hide {
  background-color: transparent;
}
#container {
  width: 750rpx;
  height: 100%;
  overflow: hidden;
}
#bg-big-circle {
  width: 750rpx;
  height: 470rpx;
  background-color: var(--color-bg);
  position: absolute;
}
#big-circle {
  width: 1250rpx;
  height: 1250rpx;
  background-color: var(--color-primary);
  border-radius: 1250rpx;
  position: absolute;
  left: -250rpx;
  top: -850rpx;
}

swiper {
  width: 750rpx;
  height: 470rpx;
  margin-top: 20rpx;
}

.best-photo {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

swiper-item image {
  width: 600rpx;
  height: 450rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
}

.info {
  width: 750rpx;
  box-sizing: border-box;
  padding: 30rpx 30rpx 15rpx 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-content: center;
  background-color: var(--color-bg);
  background-image: radial-gradient(circle at left bottom, var(--color-gray-light) 15rpx, transparent 16rpx), radial-gradient(circle at right bottom, var(--color-gray-light) 15rpx, transparent 16rpx);
}

.info .identity {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  margin-bottom: 30rpx;
}

/* 以下为信息部分 */
.info .name {
  height: 36rpx;
  font-size: 40rpx;
  line-height: 36rpx;

  font-weight: 450;
  letter-spacing: 4rpx;
  margin-left: 8rpx;
  padding-bottom: 12rpx;
  display: flex;
  align-items: center;
}

.info image.gender {
  margin-left: 10rpx;
  height: 34rpx;
  width: 34rpx;  
  padding-bottom: 12rpx;
}

.info .count {
  margin-left: 20rpx;
  order: 2;
  flex-direction: column;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
  color: var(--color-black-light);
}

.identity .iconfont {
  font-size: 30rpx;
  color: var(--color-primary);
}

.count image {
  height: 20rpx;
  width: 35rpx;
  margin: 0 3rpx 0 5rpx;
}

.comment image {
  height: 27rpx;
  width: 27rpx;
}

.info .count.first {
  margin-left: auto;
}


.tags {
  display: flex;
  align-items: center;
  justify-content: center;
}

.tags .tag {
  font-size: 24rpx;
  height: 46rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background-color: var(--color-primary-soft);
  color: var(--color-primary);
  padding: 6rpx 20rpx;
  margin-right: 20rpx;
}


.tags .to_star {
  background-color: var(--color-gray-max);
  color: var(--color-surface);
}

.tags .tag-link {
  border: 1rpx solid var(--color-primary);
  font-weight: 600;
}

.tags .mpcode {
  font-size: 40rpx;
  margin-left: auto;
  color: var(--color-primary);
}

.fb-button, .badge-all {
  font-size: 24rpx;
  font-weight: 500;
  height: 46rpx;
  line-height: 46rpx;
  padding: 0 24rpx;
  text-align: center;
  margin-left: auto;
  background-color: var(--color-primary-soft);
  color: var(--color-primary);
  border-radius: 999rpx;
}

.badge-all + .badge-all {
  margin-right: 20rpx;
}

.details {
  margin-top: 24rpx;

  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
}

/* 卡片布局 */
.details .card {
  width: 100%;
  background-color: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  margin-bottom: 24rpx;
  overflow: hidden;
}

.details .card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 30rpx;
}
.card-header {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid var(--color-gray-light);
}
.card-title {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: bold;
}

.card-title .iconfont {
  font-size: 40rpx;
  color: var(--color-primary);
  margin-right: 10rpx;
}

.details .item {
  width: 100%;
  display: flex;
  align-items: flex-start;
  padding: 20rpx 28rpx;
  box-sizing: border-box;
  position: relative;
}

.details .item:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 0;
  height: 1rpx;
  background-color: var(--dk-line);
}

.details .small {
  font-size: 16rpx;
}

.details .item .label {
  width: 150rpx;
  flex: 0 0 150rpx;
  font-size: 24rpx;
  line-height: 38rpx;
  align-items: flex-start;
  display: flex;
  color: var(--dk-text-2);
}

.details .item .value {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 38rpx;
  letter-spacing: 0;
  color: var(--dk-text);
}

.details .item.long {
  width: 100%;
}

.feedback {
  display: flex;
  flex-direction: row;
}

.sort-button {
  font-size: 25rpx;
  height: 55rpx;
  box-sizing: border-box;
  border-radius: 15rpx;
  /* background-color: var(--color-primary); */
  padding: 30rpx 16rpx 30rpx 6rpx;

  display: flex;
  align-items: center;
  justify-content: center;
}

.sort-button .icon {
  height: 25rpx;
  width: 25rpx;
  margin: 0 0 0 10rpx ;
}
.sort-button .type {
  font-weight: 400;
  margin-left: 5rpx;
}

.sort-button .picker {
  display: flex;
  align-items: center;
}

/* 下面开始相册 */
.album {
  padding: 15rpx 30rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: flex-start;
  align-items: stretch;
  flex-direction: column;
  background-color: var(--color-surface);
}

.album-title {
  text-align: center;
  padding: 20rpx;
  font-size: 34rpx;
}

.album-block {
  width: 100%;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  justify-content: center;
  margin-bottom: 25rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
}

.album-block .header {
  display: flex;
  align-items: center;
  width: 100%;
  padding: 20rpx 0;
  box-sizing: border-box;
  grid-column: 1 / -1; /* 让header横跨所有列 */
}

.album-block .header .icon-clock-o {
  font-size: 35rpx;
  margin-right: 10rpx;
  color: var(--color-primary);
}

.album-block .header .time {
  height: 35rpx;
  font-size: 35rpx;
  line-height: 35rpx;
  display: inline-block;
  margin-right: 10rpx;
  color: var(--color-black-min);
}
.album-block .header .age {
  height: 28rpx;
  font-size: 28rpx;
  line-height: 28rpx;
  display: inline-block;
  color: var(--color-gray-max);
  margin-right: 10rpx;
}

.album-block .header .birthday {
  font-size: 28rpx;
}

.album-block .album-image {
  width: 100%;
  aspect-ratio: 1/1;
  box-sizing: border-box;
  background-color: var(--color-bg);
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
}

.album-image .alb-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.album .loading {
  width: 100%;
  text-align: center;
  background-color: var(--color-surface);
  color: var(--color-gray);
  font-size: 28rpx;
  margin-top: 10rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 行内入口（原「+」悬浮弹窗的功能已拆分挂到详情页各处） */
.count.tap-on {
  color: var(--dk-accent);
}
.album-tools {
  display: flex;
  align-items: center;
  margin-right: 10rpx;
}
.album-tools .tool {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  flex-shrink: 0;
  padding: 6rpx 0;
  border-radius: 18rpx;
}
.album-tools .tool-icon {
  width: 40rpx;
  height: 40rpx;
}
.album-tools .tool-text {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 26rpx;
  color: var(--dk-text-2);
  white-space: nowrap;
}
.album-tools .tool-hover {
  background-color: rgba(12, 95, 3, 0.06);
}

/* 下面开始悬浮标题 */
.big-header {
  background-color: var(--color-surface);
  display: flex;
  align-items: center;
  border:solid var(--color-gray-light);
  border-width: 1rpx 0;
  position: sticky;
  top: 0;
  position: -webkit-sticky;
  z-index: 1;
  width: 100%;
}

.card .big-header {
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
}

.big-header .avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 70rpx;
  margin: 30rpx;
}
.big-header .name-and-count {
  display: inline-block;
  flex-grow: 1;
  min-width: 0;
}
.big-header .name-and-count .name {
  height: 36rpx;
  line-height: 36rpx;
  font-size: 32rpx;
  font-weight: 450;
  margin: 30rpx 0 10rpx 0;
  max-width: 380rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.big-header .name-and-count .count {
  height: 28rpx;
  line-height: 28rpx;
  font-size: 28rpx;
  color: var(--color-black-min);
  font-weight: 400;
  margin-bottom: 30rpx;
}

.best-photo .like-count {
  position: absolute;
  bottom: 30rpx;
  left: 50rpx;
  color: var(--color-gray-light);
  display: flex;
  align-items: center;
  font-size: 26rpx;
}

.like-logo {
  width: 30rpx;
  height: 30rpx;
  margin-right: 5rpx;
}

.album-image .like-count {
  position: absolute;
  bottom: 0rpx;
  left: 10rpx;
  color: var(--color-gray-light);
  display: flex;
  align-items: center;
  font-size: 22rpx;
}

.like-logo.small {
  width: 20rpx;
  height: 20rpx;
  margin-right: 5rpx;
}

/* 猫猫关系 */
.relations {
  width: 100%;
  white-space: nowrap;
  box-sizing: border-box;
  padding: 30rpx 5rpx;
}
.relation-block {
  width: 150rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 0;
  border-radius: 20rpx;
}
.relation-block.tap {
  background-color: var(--color-bg);
}
.relation-cat-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 100%;
  background-color: var(--color-white-dark);
}
.relation-name {
  max-width: 100rpx;
  margin-top: -20rpx;
  font-size: 20rpx;
  background-color: var(--color-primary-light);
  padding: 5rpx 10rpx;
  border-radius: 10rpx;
  white-space: nowrap;
  text-overflow:ellipsis;
  overflow:hidden;
}
.relation-cat-name {
  max-width: 150rpx;
  font-size: 24rpx;
  color: var(--color-primary);
  white-space: nowrap;
  text-overflow:ellipsis;
  overflow:hidden;
}

/* 关掉关系板块滚动条，安卓滚动条略丑 */
::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}

/* 徽章 */
.badge-all {
  float: right;
}


/* 猫猫评分 */

.one-rating {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.one-rating.detail {
  border-bottom: 1rpx solid var(--color-gray-light);
}

.one-rating .title, one-rating-title {
  font-size: 24rpx;
  text-align: right;
}

.stars {
  width: 370rpx;
  height: 60rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.one-star {
  width: 50rpx;
  height: 50rpx;
}

.one-star.gray {
  filter: grayscale(100%);
  opacity: 0.3;
}

.one-star image {
  width: 100%;
  height: 100%;
}

.score {
  margin-left: 20rpx;
  width: 50rpx;
  text-align: center;
  color: var(--color-primary);
  font-weight: bold;
}

/* 疫苗记录 */
.latest-vaccine {
  background-color: var(--color-vaccine-light);
  border-radius: 15rpx;
  padding: 15rpx;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.latest-vaccine .icon-success {
  margin-right: 10rpx;
}

.vaccine-info {
  display: flex;
  justify-content: space-between;
  width: 100%;
}

/* 疫苗记录弹出层样式 */
.modal-content-wrapper {
  width: 80vw;
  height: 100%;
  display: flex;
  flex-direction: column;
  border-radius: 40rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background-color: var(--color-surface);
  font-size: 32rpx;
  font-weight: bold;
}

.modal-close {
  font-size: 40rpx;
  color: var(--color-gray);
  padding: 0 10rpx;
}

.modal-body {
  flex: 1;
  margin-top: 20rpx;
  max-height: 70vh;
  overflow-y: auto;
}

/* 疫苗时间线样式 */
.vaccine-timeline {
  padding: 0 30rpx 0 50rpx;
  position: relative;
}

.timeline-item {
  position: relative;
  display: flex;
  margin-bottom: 30rpx;
  padding-left: 20rpx;
}

.timeline-icon {
  position: absolute;
  left: 0;
  top: 24rpx; /* 调整图标位置，与疫苗类型中心对齐 */
  z-index: 2;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  transform: translateX(-50%);
}

.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  top: 32rpx; /* 调整图标位置，与疫苗类型中心对齐 */
  background-color: var(--color-gray);
}

.icon-success {
  font-size: 40rpx;
  color: var(--color-vaccine);
}

.icon-bulb-o {
  color: var(--color-red-dark); /* 过期图标颜色 */
  font-size: 40rpx;
}

.timeline-connector {
  position: absolute;
  top: 65rpx;
  bottom: -50rpx;
  left: 0;
  width: 2rpx;
  background-color: var(--color-gray);
  transform: translateX(-50%);
}

.timeline-content {
  flex: 1;
  margin-left: 30rpx;
  background-color: var(--color-surface);
  border-radius: 15rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  padding: 20rpx;
}

/* 第一条卡片特殊背景色 */
.timeline-content.first-card {
  background-color: var(--color-vaccine-light);
}

/* 过期卡片样式 */
.timeline-content.expired-card {
  background-color: var(--color-surface);
}

/* 过期卡片内所有文本颜色 */
.timeline-content.expired-card .timeline-title,
.timeline-content.expired-card .timeline-date,
.timeline-content.expired-card .timeline-info {
  color: var(--color-gray-max);
}

.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
  gap: 8rpx;
}

.timeline-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text);
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.timeline-date {
  font-size: 24rpx;
  white-space: nowrap;
}

.timeline-body {
  font-size: 26rpx;
  color: var(--color-black-min);
  line-height: 1.6;
}

.timeline-info {
  word-break: break-all;
  margin-bottom: 8rpx;
}

/* ================= v5.0 详情页：白色主题 ================= */
page {
  background-color: var(--dk-bg);
  color: var(--dk-text);
}

/* 顶部自绘导航（返回 + 猫名） */
.dc-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  padding: 0 24rpx 0 16rpx;
  box-sizing: border-box;
  background-color: rgba(245, 247, 245, 0.92);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid var(--dk-line);
}
.dc-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 64rpx;
}
.dc-back-icon {
  width: 26rpx;
  height: 26rpx;
  border-left: 4rpx solid var(--dk-text);
  border-bottom: 4rpx solid var(--dk-text);
  transform: rotate(45deg);
  margin-left: 8rpx;
}
.dc-nav-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--dk-text);
  margin-left: 8rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 背景块全部去掉，白底为主 */
#bg-yellow {
  background-color: transparent;
  background-image: none;
}
#bg-big-circle,
#big-circle {
  display: none;
}

/* 大图轮播 */
swiper {
  height: 620rpx;
  margin-top: 0;
}
swiper-item image {
  width: 660rpx;
  height: 520rpx;
  border-radius: var(--dk-radius-lg);
  border: 1rpx solid var(--dk-line);
  box-shadow: 0 16rpx 44rpx rgba(12, 95, 3, 0.12);
}
.best-photo .like-count {
  right: 84rpx;
  top: 76rpx;
  left: auto;
  bottom: auto;
  border-radius: var(--dk-radius-pill);
  background-color: rgba(16, 22, 15, 0.45);
  color: #FFFFFF;
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  backdrop-filter: blur(8rpx);
}
.best-photo .like-logo {
  filter: none;
}

/* 信息卡：白卡上浮 */
.info {
  background-color: var(--dk-card);
  border: 1rpx solid var(--dk-line);
  border-radius: var(--dk-radius-lg) var(--dk-radius-lg) 0 0;
  margin-top: -40rpx;
  padding: 40rpx 28rpx 20rpx 28rpx;
  position: relative;
  z-index: 3;
  box-shadow: none;
}
.info .name {
  color: var(--dk-text);
  font-size: 58rpx;
  line-height: 64rpx;
  font-weight: 800;
  letter-spacing: -1.5rpx;
}
.gender {
  opacity: 0.75;
}

/* 数据胶囊 */
.identity .count {
  background-color: transparent;
  border: 1rpx solid var(--dk-line);
  border-radius: var(--dk-radius-pill);
  padding: 6rpx 18rpx;
  color: var(--dk-text-2);
  font-size: 22rpx;
}
.identity .count .iconfont {
  color: var(--dk-accent);
  font-size: 24rpx;
}
.identity .count.first {
  border-color: var(--dk-accent-line);
  background-color: var(--dk-accent-soft);
  color: var(--dk-accent-2);
}

/* 标签 */
.tags .tag {
  background-color: transparent;
  border: 1rpx solid var(--dk-line);
  border-radius: var(--dk-radius-pill);
  padding: 8rpx 22rpx;
  color: var(--dk-text-2);
  font-size: 22rpx;
  height: auto;
  line-height: 1.4;
}
.tags .to_star {
  background-color: var(--dk-accent-soft);
  border-color: var(--dk-accent-line);
  color: var(--dk-accent-2);
}

/* 下方信息块 */
.details .card,
.card {
  background-color: var(--dk-card);
  border: 1rpx solid var(--dk-line);
  border-radius: var(--dk-radius);
  box-shadow: none;
}
.details .card-header,
.card-header {
  border-bottom: 1rpx solid var(--dk-line);
  padding: 24rpx 28rpx;
}
.card-title {
  color: var(--dk-text);
  font-size: 28rpx;
  font-weight: 700;
}
.card-title .iconfont {
  color: var(--dk-accent);
}
.card-content {
  color: var(--dk-text-2);
  font-size: 25rpx;
  line-height: 38rpx;
}

/* =========================================================
   v5.2 详情页精修
   ========================================================= */

.info .name {
  font-size: 64rpx;
  letter-spacing: -1.5rpx;
}
.identity .count {
  border-radius: 999rpx;
  border: 1rpx solid var(--dk-line);
  background-color: rgba(12, 95, 3, 0.04);
}
.details .card {
  border-radius: 28rpx;
  border: 1rpx solid var(--dk-line);
  box-shadow: 0 2rpx 10rpx rgba(12, 95, 3, 0.035);
}
.details .card-header {
  border-bottom: 1rpx solid var(--dk-line);
}

/* =========================================================
   v5.3 详情页信息架构重构（档案扁平化 / 评价独立成卡）
   —— 只动间距、字号、字重、语义色，主题绿 #0C5F03 不变
   ========================================================= */

/* 猫友评价卡 */
.rating-body {
  padding: 24rpx 28rpx;
}
.rating-summary {
  display: flex;
  align-items: center;
  width: 100%;
}
.rating-score {
  font-size: 56rpx;
  line-height: 1;
  font-weight: 700;
  color: var(--dk-accent);
  margin-right: 24rpx;
}
.rating-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.rating-stars {
  display: flex;
  align-items: center;
}
.rating-count {
  font-size: 22rpx;
  line-height: 30rpx;
  color: var(--dk-text-2);
  margin-top: 8rpx;
}
.rating-toggle {
  flex: 0 0 auto;
  font-size: 24rpx;
  color: var(--dk-accent);
  padding: 8rpx 0 8rpx 20rpx;
}
.rating-dim {
  margin-top: 8rpx;
  border-top: 1rpx solid var(--dk-line);
  padding-top: 8rpx;
}
.rating-dim .one-rating {
  padding: 6rpx 0;
}
.rating-dim .one-rating .title {
  color: var(--dk-text-2);
  font-size: 24rpx;
}
.rating-dim .one-rating .score {
  color: var(--dk-accent);
  font-weight: 600;
}
