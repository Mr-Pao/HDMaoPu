/* pages/info/agreement/agreement.wxss */

.title {
  font-size: 50rpx;
  text-align: center;
}

.agreement {
  width: 750rpx;
  margin: 30rpx 0;
  font-size: 28rpx;
  box-sizing: border-box;
}
/* =========================================================
   v5.1 全站统一外观（二级页自动套用）
   与首页/图库/详情页同一套：白底、细描边、大圆角、无重阴影
   ========================================================= */
page {
  background-color: var(--dk-bg);
  color: var(--dk-text);
}

/* 卡片圆角统一到 20rpx 档 */
.card, .box, .item-card, .list-item, .cell {
  border-radius: 20rpx;
}
