<!--miniprogram/pages/info/info.wxml-->
<!-- 顶部柔光已由 page 的 radial-gradient 直接铺出（v5.6 沉浸式），不再需要 .dk-glow 叠加 -->
<view class="nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-flex">
    <view class="nav-l">
      <view class="nav-sub">MAOPU</view>
    </view>
  </view>
</view>

<!-- ① 品牌头：圆形 logo → 大标题（连击 5 次解锁管理后台）→ 一行灰字副标语 -->
<view class='mina-info'>
  <image src='{{logo_img}}' bindtap="showMpCode" show-menu-by-longpress="1"></image>
  <view class='title' catchtap="onTitleTap" hover-class="tap-dim" hover-stay-time="80">{{text_cfg.app_name}}</view>
  <view class='dev'><text>{{text_cfg.info.slogan}}</text></view>

  <!-- ② 数据条：两行三格，格间竖细线 -->
  <view class="num-info">
    <view class="num">
      <view class="num-title">{{numAllCats || '-'}}</view>
      <text class='small-title'>只猫猫</text>
    </view>
    <view class="num">
      <view class="num-title">{{numAllPhotos || '-'}}</view>
      <text class='small-title'>张照片</text>
    </view>
    <view class="num">
      <view class="num-title">{{numAllComments || '-'}}</view>
      <text class='small-title'>张便利贴</text>
    </view>
  </view>
  <view class="num-info">
    <view class="num">
      <view class="num-title">{{currentCatsCount || '-'}}</view>
      <text class='small-title'>现存猫猫</text>
    </view>
    <view class="num">
      <view class="num-title">{{adoptRate || '-'}}</view>
      <text class='small-title'>领养率</text>
    </view>
    <view class="num">
      <view class="num-title">{{sterilizationRate || '-'}}</view>
      <text class='small-title'>绝育率</text>
    </view>
  </view>
</view>

<!-- ③ 友情链接：整块按数据显隐（后台可增删，删空后不显示空卡片） -->
<block wx:if="{{friendApps.length}}">
  <view class='block-name'>{{text_cfg.info.friends}}</view>
  <view class="block">
    <view wx:for="{{friendApps}}" class="friend-link" bindtap="clickFriendLink" data-appid="{{item.appid}}" wx:key="appid">
      <image wx:if="{{item.logo}}" mode='aspectFit' src="{{item.logo}}"></image>
      <view wx:else class="friend-link-ph">{{item.initial}}</view>
      <view class="friend-link-text">{{item.name}}</view>
    </view>
  </view>
</block>

<!-- ④ 工具（历史分组，当前 menuList 只有「管理后台」一组，本块不渲染） -->
<block wx:for="{{menuList}}" wx:key="title" wx:for-item="menu" wx:if="{{showCond[menu.show]}}">
  <view wx:if="{{menu.title != '管理后台'}}" class='block-name'>{{menu.title}}</view>
  <view wx:if="{{menu.title != '管理后台'}}" class='card-container'>
    <view class="tool" wx:for="{{menu.items}}" wx:key="name" bindtap='clickbtn' data-to='{{item.path}}'>
      <view class="iconfont {{item.icon}}"></view>
      <view class="card-text" style="margin-left: 30rpx;">{{item.name}}</view>
    </view>
  </view>
</block>

<!-- ⑤ 管理后台：宫格式布局（15 项，保持 3 列），待处理数量右上角红点标记 -->
<!--    showCond.manager 由 isUnlocked() 控制，非管理员恒 false → 整块隐藏 -->
<block wx:for="{{menuList}}" wx:key="title" wx:for-item="menu" wx:if="{{showCond[menu.show]}}">
  <view wx:if="{{menu.title == '管理后台'}}" class='block-name'>{{menu.title}}</view>
    <view wx:if="{{menu.title == '管理后台'}}" class="block">
      <view wx:for="{{menu.items}}" wx:key="name" class="grid-item {{item.disabled ? 'grid-item-disabled' : ''}}" bindtap='clickbtn' data-to='{{item.path}}' data-disabled='{{item.disabled}}'>
          <view class="iconfont {{item.icon}}"></view>
          <text wx:if="{{nums[item.num]}}" class="badge">{{nums[item.num]}}</text>
          <view wx:if="{{item.dot}}" class="dot"></view>
          <text class="grid-text">{{item.name}}</text>
          <text wx:if="{{item.disabled}}" class="grid-disabled-tip">此功能需服务端支持，暂未开放</text>
      </view>
    </view>
</block>

<!-- ⑥ 关于：竖列表行组（左标题 / 右值 + ›） -->
<view class='block-name'>{{text_cfg.info.about}}</view>
<view class="about-list">
  <view class="about-row">
    <view class="about-k">{{text_cfg.info.row_version}}</view>
    <view class="about-v">{{version || '-'}}</view>
  </view>
  <view class="about-row" bindtap='clickbtn' data-to='/pages/info/reward/reward' hover-class="row-hover" hover-stay-time="80">
    <view class="about-k">{{text_cfg.info.row_reward}}</view>
    <view class="about-v">{{text_cfg.info.row_reward_value}}<text class="about-arrow">›</text></view>
  </view>
  <view class="about-row" bindtap='clickbtn' data-to='/pages/info/devTeam/devTeam' hover-class="row-hover" hover-stay-time="80">
    <view class="about-k">{{text_cfg.info.row_dev}}</view>
    <view class="about-v">{{text_cfg.info.row_dev_value}}<text class="about-arrow">›</text></view>
  </view>
  <button class="about-row about-row-btn" open-type="contact" hover-class="row-hover" hover-stay-time="80">
    <view class="about-k">{{text_cfg.info.row_contact}}</view>
    <view class="about-v">{{text_cfg.info.row_contact_value}}<text class="about-arrow">›</text></view>
  </button>
</view>

<!-- ⑦ 底tab占位 -->
<view style="height: {{tabBarHeight + 60}}px;"></view>
