.page {
  padding: 30rpx;
  min-height: 100vh;
  background: var(--color-bg);
  box-sizing: border-box;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 32rpx;
  color: var(--color-text-secondary);
}

.empty-tip {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-top: 16rpx;
}

.adoption-card {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cat-name {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--color-text);
}

.status {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-pill);
}

.status-pending {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.status-approved {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.status-rejected {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.status-cancelled {
  background: var(--color-bg);
  color: var(--color-text-tertiary);
}

.apply-time {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-top: 12rpx;
}

.review-note {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg);
  border-radius: var(--radius-md);
  padding: 16rpx;
  margin-top: 16rpx;
}

.timeline {
  margin-top: 24rpx;
  border-top: 1rpx solid var(--color-border);
  padding-top: 24rpx;
}

.timeline-item {
  display: flex;
  position: relative;
  padding-bottom: 28rpx;
}

.timeline-item::before {
  content: '';
  position: absolute;
  left: 9rpx;
  top: 24rpx;
  bottom: 0;
  width: 2rpx;
  background: var(--color-border);
}

.timeline-item:last-child::before {
  display: none;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--color-border);
  margin-right: 24rpx;
  flex-shrink: 0;
}

.dot-active {
  background: var(--color-primary);
}

.step-content {
  flex: 1;
}

.step-status {
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 500;
}

.step-note {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

.step-time {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 6rpx;
}

.actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.btn-cancel {
  color: var(--color-danger);
  border: 1rpx solid var(--color-danger);
  background: var(--color-surface);
}
