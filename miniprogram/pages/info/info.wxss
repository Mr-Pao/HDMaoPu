/* miniprogram/pages/info/info.wxss */
page {
  width: 750rpx;
  padding: 30rpx 30rpx;
  box-sizing: border-box;
  background-color: var(--color-bg);
}

.mina-info {
  display: flex;
  flex-direction: column;
  flex-wrap: wrap;
  align-items: center;
  padding: 40rpx 0 15rpx 0;
}

/* 卡片布局 */
.card-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  row-gap: 24rpx;
  margin: 10rpx 6rpx 10rpx 6rpx;
}

.card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: calc(50% - 12rpx);
  height: 190rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  background-color: var(--color-surface);
  overflow: hidden;
}
.card:after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 6rpx;
  background: var(--color-primary-bright);
  opacity: 0.85;
}

.icon {
  align-items: center;
  width: 80rpx;
  height: 80rpx;
  margin-bottom:0rpx;
}
.card-text {
  font-size: 30rpx;
  text-align: center;
  white-space: nowrap;
  font-weight: bolder;
  letter-spacing: 5rpx;
  color: var(--color-black-light);
  filter: drop-shadow(0px 5rpx 5rpx rgba(0, 0, 0, 0.15));
}

.tool {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: calc(50% - 12rpx);
  height: 104rpx;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  background-color: var(--color-surface);
  overflow: hidden;
}

/* 下面是旧的 */

.mina-info image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 20rpx;
  box-shadow: 0 0 10rpx var(--color-gray);
}

.mina-info .title {
  font-size: 33rpx;
  font-weight: 500;
  margin-top: 20rpx;
}

.mina-info .dev {
  font-size: 23rpx;
  font-weight: 300;
  margin-top: 5rpx;
  text-align: center;
}

.block-name {
  font-size:30rpx;
  font-weight: 600;
  margin-top: 35rpx;
  margin-bottom: 6rpx;
  width: 100%;
  text-align: left;
  padding-left: 6rpx;
  color: var(--color-text);
}

.block{
  background-color: var(--color-surface);
  margin: 10rpx 0;
  padding: 16rpx;
  box-shadow: var(--shadow-sm);
  border-radius: var(--radius-lg);
  display: flex;
  flex-wrap: wrap;
}


.friend-link {
  margin: 28rpx 10rpx 20rpx 5rpx;
  width: 148rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.friend-link image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  margin-bottom: 15rpx;
}

.friend-link-text {
  width: 100%;
  font-size: 25rpx;
  text-align: center;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}

/* grid */
.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  width: 33.33%; /* 三列宫格 */
  box-sizing: border-box;
  padding: 10px;
}

.grid-text {
  width: 100%;
  font-size: 25rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 失效写功能的菜单项：置灰 + 提示 */
.grid-item-disabled {
  opacity: 0.45;
}

.grid-disabled-tip {
  width: 100%;
  margin-top: 4rpx;
  font-size: 18rpx;
  color: var(--color-text-tertiary);
  text-align: center;
}

.iconfont {
  font-family: 'iconfont';
  font-size: 55rpx;
  filter: drop-shadow(0px 12rpx 12rpx rgba(0, 0, 0, 0.05));
}

.badge {
  position: absolute;
  text-align: center;
  top: 25rpx;
  right: 70rpx;
  min-width: 26rpx;
  height: 26rpx;
  line-height: 26rpx;
  border-radius: 100%;
  background-color: red;
  color: var(--color-surface);
  font-size: 19rpx;
  font-weight: bold;
  overflow: hidden;
  white-space: nowrap;
  border: 3rpx solid var(--color-surface);
  padding: 4rpx
}

.dot {
  position: absolute;
  top: 35rpx;
  right: 70rpx;
  width: 11rpx;
  height: 11rpx;
  background-color: red;
  border-radius: 50%;
}

/* 各项数据 */
.num-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0 0rpx 0;
  width: 100%;
}

.num {
  display: flex;
  flex: 1; /* 平分宽度 */
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 0 40rpx;
  height: auto;
  box-sizing: border-box;
  position: relative;
}

.num:not(:last-child)::after {
  content: '';
  position: absolute;
  top: 50%;
  right: 0;
  transform: translateY(-50%);
  height: 60%;
  width: 1rpx;
  background-color: var(--color-gray);
}

.num-title {
  margin-bottom: -10rpx;
  font-size: 25rpx;
  text-align: center;
  white-space: nowrap;
}
.small-title {
  font-size: 20rpx;
  font-weight: 300;
}

.buttons {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.buttons .button {
  width: 330rpx;
  height: 182rpx;
  border-radius: 15rpx;
  box-shadow: 0rpx 0rpx 10rpx var(--color-gray-light);
  margin-top: 30rpx;
}

/*弹出层*/
.plus {
  width: 100rpx;
  height: 100rpx;
  position: fixed;
  bottom: 200rpx;
  right: 50rpx;
  filter: drop-shadow(0px 12rpx 12rpx rgba(0, 0, 0, 0.15));
  display: block;
  justify-content: center;
  align-items: center;
  z-index: 1;
}

