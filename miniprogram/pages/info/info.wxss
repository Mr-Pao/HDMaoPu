/* miniprogram/pages/info/info.wxss */
page {
  width: 750rpx;
  /* 左右 24rpx：下面各卡容器自己也留 24rpx，
     合计 48rpx，与首页猫卡（.cards padding 24 + .row margin 24）完全对齐 */
  padding: 30rpx 24rpx;
  box-sizing: border-box;
  background-color: var(--color-bg);
}

.mina-info {
  display: flex;
  flex-direction: column;
  flex-wrap: wrap;
  align-items: center;
  padding: 40rpx 0 15rpx 0;
}

/* 卡片布局 */
.card-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  row-gap: 24rpx;
  margin: 10rpx 6rpx 10rpx 6rpx;
}

.card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: calc(50% - 12rpx);
  height: 190rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  background-color: var(--color-surface);
  overflow: hidden;
}
.card:after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 6rpx;
  background: var(--color-primary-bright);
  opacity: 0.85;
}

.icon {
  align-items: center;
  width: 80rpx;
  height: 80rpx;
  margin-bottom:0rpx;
}
.card-text {
  font-size: 30rpx;
  text-align: center;
  white-space: nowrap;
  font-weight: bolder;
  letter-spacing: 5rpx;
  color: var(--color-black-light);
  filter: drop-shadow(0px 5rpx 5rpx rgba(0, 0, 0, 0.15));
}

.tool {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: calc(50% - 12rpx);
  height: 104rpx;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  background-color: var(--color-surface);
  overflow: hidden;
}

/* 下面是旧的 */

.mina-info image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 20rpx;
  box-shadow: 0 0 10rpx var(--color-gray);
}

.mina-info .title {
  font-size: 33rpx;
  font-weight: 500;
  margin-top: 20rpx;
}

.mina-info .dev {
  font-size: 23rpx;
  font-weight: 300;
  margin-top: 5rpx;
  text-align: center;
}

.block-name {
  font-size:30rpx;
  font-weight: 600;
  margin-top: 35rpx;
  margin-bottom: 6rpx;
  width: 100%;
  text-align: left;
  padding-left: 6rpx;
  color: var(--color-text);
}

.block{
  background-color: var(--color-surface);
  margin: 10rpx 0;
  padding: 16rpx;
  box-shadow: var(--shadow-sm);
  border-radius: var(--radius-lg);
  display: flex;
  flex-wrap: wrap;
}


.friend-link {
  margin: 28rpx 10rpx 20rpx 5rpx;
  width: 148rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.friend-link image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  margin-bottom: 15rpx;
}

.friend-link-text {
  width: 100%;
  font-size: 25rpx;
  text-align: center;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}

/* 没有 logo 时的占位（后台新增的友情链接可能不填图） */
.friend-link-ph {
  width: 100rpx;
  height: 100rpx;
  line-height: 100rpx;
  margin-bottom: 15rpx;
  border-radius: 50rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--dk-accent, #0C5F03);
  background: var(--color-primary-soft, #E8F3EA);
}

/* grid */
.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  width: 33.33%; /* 三列宫格 */
  box-sizing: border-box;
  padding: 10px;
}

.grid-text {
  width: 100%;
  font-size: 25rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 失效写功能的菜单项：置灰 + 提示 */
.grid-item-disabled {
  opacity: 0.45;
}

.grid-disabled-tip {
  width: 100%;
  margin-top: 4rpx;
  font-size: 18rpx;
  color: var(--color-text-tertiary);
  text-align: center;
}

.iconfont {
  font-family: 'iconfont';
  font-size: 55rpx;
  filter: drop-shadow(0px 12rpx 12rpx rgba(0, 0, 0, 0.05));
}

.badge {
  position: absolute;
  text-align: center;
  top: 25rpx;
  right: 70rpx;
  min-width: 26rpx;
  height: 26rpx;
  line-height: 26rpx;
  border-radius: 100%;
  background-color: red;
  color: var(--color-surface);
  font-size: 19rpx;
  font-weight: bold;
  overflow: hidden;
  white-space: nowrap;
  border: 3rpx solid var(--color-surface);
  padding: 4rpx
}

.dot {
  position: absolute;
  top: 35rpx;
  right: 70rpx;
  width: 11rpx;
  height: 11rpx;
  background-color: red;
  border-radius: 50%;
}

/* 各项数据 */
.num-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0 0rpx 0;
  width: 100%;
}

.num {
  display: flex;
  flex: 1; /* 平分宽度 */
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 0 40rpx;
  height: auto;
  box-sizing: border-box;
  position: relative;
}

.num:not(:last-child)::after {
  content: '';
  position: absolute;
  top: 50%;
  right: 0;
  transform: translateY(-50%);
  height: 60%;
  width: 1rpx;
  background-color: var(--color-gray);
}

.num-title {
  margin-bottom: -10rpx;
  font-size: 25rpx;
  text-align: center;
  white-space: nowrap;
}
.small-title {
  font-size: 20rpx;
  font-weight: 300;
}

.buttons {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.buttons .button {
  width: 330rpx;
  height: 182rpx;
  border-radius: 15rpx;
  box-shadow: 0rpx 0rpx 10rpx var(--color-gray-light);
  margin-top: 30rpx;
}

/*弹出层*/
.plus {
  width: 96rpx;
  height: 96rpx;
  position: fixed;
  bottom: 220rpx;
  right: 40rpx;
  border-radius: 50%;
  border: 6rpx solid #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(12, 95, 3, 0.22);
  filter: drop-shadow(0px 12rpx 12rpx rgba(0, 0, 0, 0.15));
  display: block;
  justify-content: center;
  align-items: center;
  z-index: 1;
}

/* ================= v5.0 我的页：白色主题 ================= */
page {
  background-color: var(--dk-bg);
  color: var(--dk-text);
}

/* 品牌头：白卡 + 细描边 */
.mina-info {
  margin: 0 24rpx;
  padding: 40rpx 32rpx 30rpx 32rpx;
  background-color: var(--dk-card);
  border: 1rpx solid var(--dk-line);
  border-radius: var(--dk-radius-lg);
  box-shadow: none;
}
.mina-info image {
  width: 136rpx;
  height: 136rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--dk-line);
  box-shadow: none;
}
.mina-info .title {
  color: var(--dk-text);
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
  margin-top: 20rpx;
}
.mina-info .dev {
  color: var(--dk-text-3);
  font-size: 21rpx;
}

/* 数据栏：三栏大数字 + 发丝分隔 */
.num-info {
  padding: 0;
  margin-top: 28rpx;
  width: 100%;
}
.num {
  padding: 0;
}
.num:not(:last-child)::after {
  background-color: var(--dk-line);
}
.num-title {
  color: var(--dk-text);
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: -1.5rpx;
  margin-bottom: 0;
}
.small-title {
  color: var(--dk-text-3);
  font-size: 19rpx;
  letter-spacing: 1rpx;
  font-weight: 400;
}

/* 宫格卡片 */
.card-container {
  margin: 18rpx 24rpx 0 24rpx;
  row-gap: 14rpx;
}
.card,
.tool {
  background-color: var(--dk-card);
  border: 1rpx solid var(--dk-line);
  border-radius: var(--dk-radius);
  box-shadow: none;
}
.card {
  height: 180rpx;
}
.card:after {
  display: none;
}
.card .card-text {
  color: var(--dk-text);
  font-weight: 700;
  filter: none;
}
.card .icon {
  filter: none;
  opacity: 1;
}

/* 分节标题 */
.block-name {
  color: var(--dk-text-3);
  font-size: 19rpx;
  letter-spacing: 3rpx;
  text-transform: uppercase;
  font-weight: 600;
  padding-left: 0;
  margin: 36rpx 28rpx 14rpx 28rpx;
}
.block-name::before {
  display: none;
}
.block {
  background-color: var(--dk-card);
  border: 1rpx solid var(--dk-line);
  border-radius: var(--dk-radius);
  box-shadow: none;
  margin: 0 24rpx;
}
.friend-link-text {
  color: var(--dk-text-2);
}
.grid-text {
  color: var(--dk-text-2);
}
.grid-disabled-tip {
  color: var(--dk-text-3);
}

/* =========================================================
   v5.2 我的页精修
   ========================================================= */

.mina-info {
  margin: 12rpx 24rpx 0 24rpx;
  padding: 44rpx 32rpx 34rpx 32rpx;
  border-radius: 34rpx;
  background-color: var(--dk-card);
  border: 1rpx solid var(--dk-line);
  box-shadow: 0 2rpx 14rpx rgba(12, 95, 3, 0.05);
}
.title {
  font-size: 46rpx;
  letter-spacing: -1rpx;
}
.num-title {
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}
.small-title {
  font-size: 19rpx;
  letter-spacing: 1rpx;
  color: var(--dk-text-3);
}
.card,
.tool,
.block {
  border-radius: 26rpx;
  border: 1rpx solid var(--dk-line);
  box-shadow: 0 2rpx 10rpx rgba(12, 95, 3, 0.035);
}

/* 顶部「关于」大标题已按用户要求移除（2026-11-01），只留 MAOPU 小字，
   这里给导航栏补一点下边距，避免和下方品牌区贴太近 */
.nav {
  padding-bottom: 22rpx;
}

/* =========================================================
   v5.5 关于页布局重构（参考 SpaceLaunch「我的」页）
   分节顺序：品牌头 → 数据条 → 友情链接 → 管理后台 → 关于 → 底部声明
   新增样式一律用 app.wxss 已有 token，不新增硬编码色值
   ========================================================= */

/* 「火大猫谱」大标题现在承载连击解锁，给一点点击反馈区域 */
.mina-info .title {
  padding: 4rpx 12rpx;
  border-radius: var(--dk-radius);
}
.tap-dim {
  background-color: var(--dk-accent-soft);
}

/* 数据条与标语之间的呼吸 */
.mina-info .dev {
  margin-top: 12rpx;
  line-height: 1.5;
}
.mina-info .num-info {
  margin-top: 30rpx;
  padding: 0;
}
/* 第二行数据条与第一行拉开一点点，仍靠竖线分格 */
.mina-info .num-info + .num-info {
  margin-top: 20rpx;
}
.num-title {
  margin-bottom: 6rpx;
  line-height: 1.1;
}
.small-title {
  line-height: 1.3;
}

/* 数据条直接与友情链接/管理后台衔接，补一点上间距 */
.mina-info + .block-name {
  margin-top: 34rpx;
}

/* 工具分组（menuList 里非「管理后台」的组）仍用两列卡片 */
.card-container {
  margin: 0 24rpx;
}
.card {
  height: 176rpx;
  justify-content: center;
}
.card .icon {
  margin-bottom: 14rpx;
}
.card .card-text {
  font-size: 27rpx;
  letter-spacing: 1rpx;
}

/* 关于：竖列表行组 */
.about-list {
  margin: 0 24rpx;
  background-color: var(--dk-card);
  border: 1rpx solid var(--dk-line);
  border-radius: 26rpx;
  box-shadow: 0 2rpx 10rpx rgba(12, 95, 3, 0.035);
  overflow: hidden;
}
.about-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 26rpx;
  box-sizing: border-box;
}
.about-row + .about-row {
  border-top: 1rpx solid var(--dk-line);
}
.row-hover {
  background-color: var(--dk-accent-soft);
}
.about-k {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--dk-text);
}
.about-v {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--dk-text-3);
}
.about-arrow {
  margin-left: 10rpx;
  font-size: 28rpx;
  line-height: 1;
  color: var(--dk-text-3);
}

/* <button> 当行用：清掉微信默认外观，保证与普通行完全一致 */
.about-row-btn {
  width: 100%;
  margin: 0;
  background-color: transparent;
  border: none;
  border-radius: 0;
  line-height: inherit;
  text-align: left;
  font-size: inherit;
  color: inherit;
}
.about-row-btn::after {
  border: none;
  display: none;
}

/* 底部声明小字已按用户要求移除（2026-11-01），.foot-note 不再使用 */

/* =========================================================
   v5.6 沉浸式顶部
   品牌区（logo / 大标题 / 标语 / 两行数据条）不再套白卡片，
   直接压在整页浅绿渐变上；下面的友情链接 / 管理后台 / 关于仍是卡片。
   ========================================================= */

page {
  background-color: var(--dk-bg);
  background-image: radial-gradient(
    160% 52% at 50% 0%,
    rgba(12, 95, 3, 0.20) 0%,
    rgba(12, 95, 3, 0.09) 38%,
    rgba(12, 95, 3, 0.02) 64%,
    rgba(12, 95, 3, 0) 82%
  );
  background-repeat: no-repeat;
}

/* 品牌区：彻底去掉卡片外观，留白由自己撑 */
.mina-info {
  margin: 0;
  padding: 30rpx 32rpx 8rpx 32rpx;
  background-color: transparent;
  border: none;
  border-radius: 0;
  box-shadow: none;
}

/* logo 加一圈柔光，让它像浮在背景上而不是贴上去 */
.mina-info image {
  box-shadow: 0 10rpx 30rpx rgba(12, 95, 3, 0.16);
}

.mina-info .title {
  font-size: 50rpx;
  letter-spacing: -1.2rpx;
  margin-top: 22rpx;
}

.mina-info .dev {
  margin-top: 14rpx;
}

/* 数据条去掉卡片后，与下方卡片的间距靠自身补足 */
.mina-info .num-info {
  margin-top: 34rpx;
}

/* 第一张卡片与品牌区之间留出「分节」的距离 */
.mina-info + .block-name {
  margin-top: 44rpx;
}


