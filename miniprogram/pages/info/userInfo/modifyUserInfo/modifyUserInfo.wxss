/* pages/info/userInfo/modifyUserInfo/modifyUserInfo.wxss */

page {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.top-margin-100 {
  margin-top: 100rpx;
}

.avatar-wrapper, image.avatar {
  width: 250rpx;
  height: 250rpx;
  padding: 0;
  border: 0;
}

button.primary {
  margin-top: 10rpx;
  background-color: var(--color-primary);
  width: 300rpx;
  color: var(--color-white-dark);
}

picker, input {
  border-bottom: 2rpx var(--color-primary) solid;
  background-color: var(--color-white-dark);
  padding: 15rpx;
  margin-bottom: 20rpx;
  color: var(--color-black-light);
  text-align: center;
}

.label-small {
  font-size: 28rpx;
  color: var(--color-black-min);
  margin-top: 30rpx;
}

.label-tip {
  font-size: 20rpx;
  color: var(--color-gray-dark);
  margin-bottom: 10rpx;
}

.nickname-input {
  width: 400rpx;
}
/* =========================================================
   v5.1 全站统一外观（二级页自动套用）
   与首页/图库/详情页同一套：白底、细描边、大圆角、无重阴影
   ========================================================= */
page {
  background-color: var(--dk-bg);
  color: var(--dk-text);
}

/* 卡片圆角统一到 20rpx 档 */
.card, .box, .item-card, .list-item, .cell {
  border-radius: 20rpx;
}
