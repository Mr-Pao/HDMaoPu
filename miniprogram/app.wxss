/**app.wxss**/
page {
  /* ================= 品牌色（绿色主题，保持不变） ================= */
  --color-primary: #0C5F03;
  --color-primary-dark: #0C5F03;
  --color-primary-light:  #8FBC94;

  /* 品牌色的可扩展梯度：深绿用于文字/描边，亮绿用于按钮底色，
     浅绿用于标签底，最浅用于大面积点缀 */
  --color-primary-bright: #17803C;
  --color-primary-soft: #E8F3EA;
  --color-primary-softer: #F3F8F4;

  /* ================= 中性色（重排为语义化层级） ================= */
  --color-white-dark: #fafafa;
  --color-white: #fafafa;

  --color-gray-light: #F5F7F5;
  --color-gray-normal: #eeeeee;
  --color-gray: #dddddd;
  --color-gray-dark: #bbbbbb;
  --color-gray-max: #888888;

  --color-black-min: #414141;
  --color-black-light: #222222;

  --color-black-transparent: rgba(0,0,0,0.5);
  --color-ltblack-transparent: rgba(0,0,0,0.05);

  /* 语义化文字/背景/描边 */
  --color-text: #1F2421;
  --color-text-secondary: #55605A;
  --color-text-tertiary: #8A948E;
  --color-text-placeholder: #B4BCB7;
  --color-bg: #F5F7F5;
  --color-surface: #FFFFFF;
  --color-border: #ECEFEC;
  /* 主色底上的文字色：此前被 10+ 个 wxss 引用但从未定义，导致主色按钮文字回退成继承色 */
  --color-text-onPrimary: #FFFFFF;

  /* ================= 状态色 ================= */
  --color-red: #dc3545;
  --color-red-dark: #8b0000;

  --color-green: #22ad6d;
  --color-green-dark: #015e32;

  /* 业务状态色：底色/前景成对使用，避免各处散落的 Ant 色板 */
  --color-warning: #C4761A;
  --color-warning-soft: #FDF3E4;
  --color-info: #1A6FC4;
  --color-info-soft: #E9F2FB;
  --color-success: #17803C;
  --color-success-soft: #E8F3EA;
  --color-danger: #D33A3A;
  --color-danger-soft: #FCEDED;

  --color-badge-A: #ffa601;
  --color-badge-B: #004ad3;
  --color-badge-C: #258100;

  /* ================= 便利贴配色 ================= */
  --color-comment-paper-white: #ffffff;
  --color-comment-paper-yellow: #fff7ee;
  --color-comment-paper-green: #ebffe9;
  --color-comment-paper-pink: #ffeffe;
  --color-comment-tape: thistle;

  /* ================= 圆角 ================= */
  --radius-sm: 10rpx;
  --radius-md: 18rpx;
  --radius-lg: 26rpx;
  --radius-pill: 999rpx;

  /* ================= 阴影 ================= */
  --shadow-sm: 0 2rpx 8rpx rgba(12, 95, 3, 0.05);
  --shadow-md: 0 6rpx 20rpx rgba(12, 95, 3, 0.07);
  --shadow-lg: 0 12rpx 32rpx rgba(12, 95, 3, 0.10);

  /* ================= 间距 ================= */
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;

  /* ================= 字号 ================= */
  --font-xs: 22rpx;
  --font-sm: 26rpx;
  --font-md: 30rpx;
  --font-lg: 34rpx;
  --font-xl: 40rpx;

  background: var(--color-bg);
  color: var(--color-text);
  font-size: var(--font-md);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;

  --img-default: url(data:image/svg+xml;base64,);
}

/* =========================================================
   通用组件类（mc = maopu component）
   全站统一圆角 / 阴影 / 留白 / 字号层级。
   页面可以逐步套用，不影响已有样式。
   ========================================================= */

/* 卡片：白底、大圆角、极柔阴影 */
.mc-card {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: var(--space-md);
  box-sizing: border-box;
}

.mc-card--flat {
  box-shadow: none;
  border: 1rpx solid var(--color-border);
}

/* 区块标题：左侧一条绿色短竖线 */
.mc-section-title {
  display: flex;
  align-items: center;
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text);
  padding: var(--space-sm) 0;
}

.mc-section-title::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  border-radius: var(--radius-pill);
  background: var(--color-primary-bright);
  margin-right: var(--space-sm);
}

/* 按钮 */
.mc-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  padding: 0 var(--space-lg);
  border-radius: var(--radius-md);
  font-size: var(--font-md);
  box-sizing: border-box;
}

.mc-btn--primary {
  background: var(--color-primary-bright);
  color: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(23, 128, 60, 0.24);
}

.mc-btn--ghost {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.mc-btn--plain {
  background: var(--color-surface);
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-border);
}

.mc-btn--block {
  width: 100%;
}

/* 标签 */
.mc-tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 var(--space-sm);
  border-radius: var(--radius-pill);
  font-size: var(--font-xs);
  background: var(--color-primary-soft);
  color: var(--color-primary-bright);
}

/* 列表行 */
.mc-cell {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 0 var(--space-md);
  background: var(--color-surface);
  font-size: var(--font-md);
  color: var(--color-text);
}

.mc-divider {
  height: 1rpx;
  background: var(--color-border);
}

/* 空状态 */
.mc-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: var(--color-text-tertiary);
  font-size: var(--font-sm);
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
} 

/* 下面是没有授权的 */
.unAuth {
  display: flex;
  flex-direction: column;
  flex-wrap: wrap;
  align-content: center;
}

.unAuth text {
  margin: 600rpx 0 30rpx 0;
  text-align: center;
  font-size: 34rpx;
}

@import "./pages/public/wxss/iconfont.wxss"


/* ================= 深色沉浸式主题（v4.4） ================= */
page {
  --dk-bg: #080B09;
  --dk-bg-2: #0C100E;
  --dk-card: rgba(255, 255, 255, 0.055);
  --dk-card-2: rgba(255, 255, 255, 0.085);
  --dk-line: rgba(255, 255, 255, 0.10);
  --dk-text: #EDF2ED;
  --dk-text-2: rgba(237, 242, 237, 0.62);
  --dk-text-3: rgba(237, 242, 237, 0.38);
  --dk-accent: #4ADE80;
  --dk-accent-soft: rgba(74, 222, 128, 0.14);
  --dk-radius: 32rpx;
  background-color: #080B09;
  color: #EDF2ED;
}

.dk-card {
  background-color: var(--dk-card);
  border: 1rpx solid var(--dk-line);
  border-radius: var(--dk-radius);
}


/* ================= 浅色沉浸式主题（v4.5） ================= */
page {
  --dk-bg: #F7F9F7;
  --dk-bg-2: #FFFFFF;
  --dk-card: #FFFFFF;
  --dk-card-2: rgba(12, 95, 3, 0.06);
  --dk-line: rgba(12, 95, 3, 0.10);
  --dk-text: #0F1A10;
  --dk-text-2: rgba(15, 26, 16, 0.55);
  --dk-text-3: rgba(15, 26, 16, 0.34);
  --dk-accent: #0C5F03;
  --dk-accent-soft: rgba(12, 95, 3, 0.08);
  --dk-radius: 32rpx;
  background-color: #F7F9F7;
  color: #0F1A10;
}

.dk-card {
  background-color: #FFFFFF;
  border: 1rpx solid rgba(12, 95, 3, 0.08);
  border-radius: var(--dk-radius);
  box-shadow: 0 8rpx 24rpx rgba(12, 95, 3, 0.06);
}
