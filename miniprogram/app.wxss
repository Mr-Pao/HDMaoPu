/**app.wxss**/
page {
  /* ================= 品牌色（绿色主题，保持不变） ================= */
  --color-primary: #0C5F03;
  --color-primary-dark: #0C5F03;
  --color-primary-light:  #8FBC94;

  /* 品牌色的可扩展梯度：深绿用于文字/描边，亮绿用于按钮底色，
     浅绿用于标签底，最浅用于大面积点缀 */
  --color-primary-bright: #17803C;
  --color-primary-soft: #E8F3EA;
  --color-primary-softer: #F3F8F4;

  /* ================= 中性色（重排为语义化层级） ================= */
  --color-white-dark: #fafafa;
  --color-white: #fafafa;

  --color-gray-light: #F5F7F5;
  --color-gray-normal: #eeeeee;
  --color-gray: #dddddd;
  --color-gray-dark: #bbbbbb;
  --color-gray-max: #888888;

  --color-black-min: #414141;
  --color-black-light: #222222;

  --color-black-transparent: rgba(0,0,0,0.5);
  --color-ltblack-transparent: rgba(0,0,0,0.05);

  /* 语义化文字/背景/描边 */
  --color-text: #1F2421;
  --color-text-secondary: #55605A;
  --color-text-tertiary: #8A948E;
  --color-text-placeholder: #B4BCB7;
  --color-bg: #F5F7F5;
  --color-surface: #FFFFFF;
  --color-border: #ECEFEC;
  /* 主色底上的文字色：此前被 10+ 个 wxss 引用但从未定义，导致主色按钮文字回退成继承色 */
  --color-text-onPrimary: #FFFFFF;

  /* ================= 状态色 ================= */
  --color-red: #dc3545;
  --color-red-dark: #8b0000;

  --color-green: #22ad6d;
  --color-green-dark: #015e32;

  /* 业务状态色：底色/前景成对使用，避免各处散落的 Ant 色板 */
  --color-warning: #C4761A;
  --color-warning-soft: #FDF3E4;
  --color-info: #1A6FC4;
  --color-info-soft: #E9F2FB;
  --color-success: #17803C;
  --color-success-soft: #E8F3EA;
  --color-danger: #D33A3A;
  --color-danger-soft: #FCEDED;

  --color-badge-A: #ffa601;
  --color-badge-B: #004ad3;
  --color-badge-C: #258100;

  /* ================= 便利贴配色 ================= */
  --color-comment-paper-white: #ffffff;
  --color-comment-paper-yellow: #fff7ee;
  --color-comment-paper-green: #ebffe9;
  --color-comment-paper-pink: #ffeffe;
  --color-comment-tape: thistle;

  /* ================= 圆角 ================= */
  --radius-sm: 10rpx;
  --radius-md: 18rpx;
  --radius-lg: 26rpx;
  --radius-pill: 999rpx;

  /* ================= 阴影 ================= */
  --shadow-sm: 0 2rpx 8rpx rgba(12, 95, 3, 0.05);
  --shadow-md: 0 6rpx 20rpx rgba(12, 95, 3, 0.07);
  --shadow-lg: 0 12rpx 32rpx rgba(12, 95, 3, 0.10);

  /* ================= 间距 ================= */
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;

  /* ================= 字号 ================= */
  --font-xs: 22rpx;
  --font-sm: 26rpx;
  --font-md: 30rpx;
  --font-lg: 34rpx;
  --font-xl: 40rpx;

  background: var(--color-bg);
  color: var(--color-text);
  font-size: var(--font-md);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;

  --img-default: url(data:image/svg+xml;base64,);
}

/* =========================================================
   通用组件类（mc = maopu component）
   全站统一圆角 / 阴影 / 留白 / 字号层级。
   页面可以逐步套用，不影响已有样式。
   ========================================================= */

/* 卡片：白底、大圆角、极柔阴影 */
.mc-card {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: var(--space-md);
  box-sizing: border-box;
}

.mc-card--flat {
  box-shadow: none;
  border: 1rpx solid var(--color-border);
}

/* 区块标题：左侧一条绿色短竖线 */
.mc-section-title {
  display: flex;
  align-items: center;
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text);
  padding: var(--space-sm) 0;
}

.mc-section-title::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  border-radius: var(--radius-pill);
  background: var(--color-primary-bright);
  margin-right: var(--space-sm);
}

/* 按钮 */
.mc-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  padding: 0 var(--space-lg);
  border-radius: var(--radius-md);
  font-size: var(--font-md);
  box-sizing: border-box;
}

.mc-btn--primary {
  background: var(--color-primary-bright);
  color: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(23, 128, 60, 0.24);
}

.mc-btn--ghost {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.mc-btn--plain {
  background: var(--color-surface);
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-border);
}

.mc-btn--block {
  width: 100%;
}

/* 标签 */
.mc-tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 var(--space-sm);
  border-radius: var(--radius-pill);
  font-size: var(--font-xs);
  background: var(--color-primary-soft);
  color: var(--color-primary-bright);
}

/* 列表行 */
.mc-cell {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 0 var(--space-md);
  background: var(--color-surface);
  font-size: var(--font-md);
  color: var(--color-text);
}

.mc-divider {
  height: 1rpx;
  background: var(--color-border);
}

/* 空状态 */
.mc-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: var(--color-text-tertiary);
  font-size: var(--font-sm);
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
} 

/* 下面是没有授权的 */
.unAuth {
  display: flex;
  flex-direction: column;
  flex-wrap: wrap;
  align-content: center;
}

.unAuth text {
  margin: 600rpx 0 30rpx 0;
  text-align: center;
  font-size: 34rpx;
}

@import "./pages/public/wxss/iconfont.wxss"


/* =========================================================
   v5.0 沉浸式深色主题（唯一生效主题）
   参考物：深空 / 发射直播类 App —— 近黑微绿底、半透明玻璃卡、
   1rpx 极细描边、大号数据、胶囊控件、浮岛底部导航。
   旧 v4.4~v4.7 四套叠加主题已删除，避免规则互殴。
   ========================================================= */
page {
  /* 底色三层：最底 / 次级面 / 玻璃卡面 */
  --dk-bg: #F5F7F5;
  --dk-bg-2: #FFFFFF;
  --dk-card: #FFFFFF;
  --dk-card-2: #FFFFFF;
  --dk-card-solid: #FFFFFF;

  /* 描边：极细淡绿，营造玻璃边界 */
  --dk-line: rgba(12, 95, 3, 0.10);
  --dk-line-strong: rgba(12, 95, 3, 0.20);

  /* 文字三级 */
  --dk-text: #10160F;
  --dk-text-2: rgba(16, 22, 15, 0.62);
  --dk-text-3: rgba(16, 22, 15, 0.38);

  /* 强调绿：品牌绿不改色号 */
  --dk-accent: #0C5F03;
  --dk-accent-2: #14801F;
  --dk-accent-soft: rgba(12, 95, 3, 0.08);
  --dk-accent-line: rgba(12, 95, 3, 0.22);

  /* 形状 */
  --dk-radius: 28rpx;
  --dk-radius-lg: 36rpx;
  --dk-radius-pill: 999rpx;
  --dk-gap: 24rpx;

  background-color: var(--dk-bg);
  color: var(--dk-text);
}

/* 顶部渐变光晕：让浅底不至于死板 */
.dk-glow {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  height: 520rpx;
  pointer-events: none;
  background: radial-gradient(
    120% 80% at 20% 0%,
    rgba(12, 95, 3, 0.10) 0%,
    rgba(12, 95, 3, 0.03) 34%,
    rgba(245, 247, 245, 0) 72%
  );
  z-index: 0;
}

/* 玻璃卡：半透明 + 细描边 + 大圆角 */
.dk-card {
  background-color: var(--dk-card);
  border: 1rpx solid var(--dk-line);
  border-radius: var(--dk-radius);
  box-sizing: border-box;
}

/* 大数字 / 数据栏 */
.dk-num {
  color: var(--dk-text);
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.dk-num-k {
  color: var(--dk-text-3);
  font-size: 20rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
}

/* 胶囊标签 */
.dk-pill {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: var(--dk-radius-pill);
  font-size: 21rpx;
  color: var(--dk-accent-2);
  background-color: var(--dk-accent-soft);
  border: 1rpx solid var(--dk-accent-line);
}

/* 自绘导航栏（navigationStyle: custom 后各页共用） */
.nav {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 0 32rpx 14rpx 32rpx;
  box-sizing: border-box;
  z-index: 20;
}

.nav-sub {
  color: var(--dk-text-3);
  font-size: 19rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.nav-title {
  color: var(--dk-text);
  font-size: 46rpx;
  line-height: 50rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  margin-top: 8rpx;
}

.nav-flex {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.nav-num {
  font-size: 46rpx;
  line-height: 50rpx;
  font-weight: 800;
  letter-spacing: -1.5rpx;
  color: var(--dk-accent);
}

.nav-num-k {
  font-size: 19rpx;
  letter-spacing: 1rpx;
  color: var(--dk-text-3);
  margin-left: 8rpx;
}
